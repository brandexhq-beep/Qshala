# QShala Sanity CMS Environment Configuration
# Copy this file to .env and supply your project credentials from https://manage.sanity.io

# Public Sanity Project ID (Found in your Sanity Project dashboard)
PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id

# Public Sanity Dataset Name (Usually 'production')
PUBLIC_SANITY_DATASET=production

# Sanity API Version (Defaults to '2024-03-01')
PUBLIC_SANITY_API_VERSION=2024-03-01

# Sanity Write / Content Token (Required ONLY for scripts/seed-sanity.mjs and webhook verification)
# NEVER commit your actual token to version control or expose in client-side code!
SANITY_API_TOKEN=your_private_sanity_token

# Shopify Storefront API Configuration
# Found in Shopify Admin -> Settings -> Apps and sales channels -> Develop apps / Headless
PUBLIC_SHOPIFY_STORE_DOMAIN=your-shop-name.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret

# Optional Inbound Lead Webhook (Slack / Zapier / Make / Formspree / API endpoint)
# Dispatches real-time booking inquiries and contact messages
PUBLIC_LEADS_WEBHOOK_URL=https://your-webhook-endpoint.com/api/leads

# Web3Forms Contact Form Access Key (https://web3forms.com)
PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key


