---
import '../styles/global.css';
import LoadingScreen from '../components/LoadingScreen';
import { ClientRouter } from 'astro:transitions';

export interface BreadcrumbItem {
  name: string;
  item: string;
}

export interface ArticleMetadata {
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
}

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'ItemPage' | 'CollectionPage' | 'FAQPage';
  breadcrumbs?: BreadcrumbItem[];
  articleMeta?: ArticleMetadata;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = "QShala | Questions • Quriosity • Quests — India's Quriosity Company",
  description = "Replacing Rote Learning with Quriosity, Socratic Storytelling, and Inquiry. Partnering with 250+ Schools & 80+ Corporates across India. Founded by Quizmasters Sachin Ravi & Raghav Chakravarthy.",
  canonical,
  ogImage,
  ogType = 'website',
  noindex = false,
  pageType = 'WebPage',
  breadcrumbs,
  articleMeta,
  schema
} = Astro.props;

const siteUrl = 'https://qshala.vercel.app';
// Strip query/UTM parameters and clean trailing slash
const cleanPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = canonical || (cleanPath === '/' ? siteUrl : `${siteUrl}${cleanPath}`);
const ogImageUrl = ogImage || `${siteUrl}/og-image.jpg`;
const ogImageType = ogImageUrl.endsWith('.png')
  ? 'image/png'
  : ogImageUrl.endsWith('.webp')
  ? 'image/webp'
  : 'image/jpeg';

// Master Organization & LocalBusiness Entity
const orgEntity: Record<string, any> = {
  "@type": ["EducationalOrganization", "LocalBusiness"],
  "@id": `${siteUrl}/#organization`,
  "name": "QShala",
  "legalName": "Curiosita Educational Services Pvt. Ltd.",
  "alternateName": ["QShala India", "Walnut Knowledge Solutions", "Curiosita Educational Services"],
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/assets/logos/QShala%20Logo%201.svg`,
    "caption": "QShala Logo"
  },
  "image": `${siteUrl}/og-image.jpg`,
  "description": "India's premier curiosity platform fostering socratic questioning, critical thinking, school curiosity clubs, and corporate trivia engagement.",
  "telephone": "+91-89716-76100",
  "email": "qshala@walnuts.co.in",
  "priceRange": "$$",
  "currenciesAccepted": "INR",
  "paymentAccepted": "Credit Card, Debit Card, UPI, Net Banking",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1st Floor, 680, Fortuna 1, 8th Main Road, 14th Cross Road, Near Delmia Circle, 3rd Phase, J.P. Nagar",
    "addressLocality": "Bengaluru",
    "addressRegion": "Karnataka",
    "postalCode": "560078",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 12.9063,
    "longitude": 77.5857
  },
  "areaServed": [
    {
      "@type": "Country",
      "name": "India"
    },
    {
      "@type": "City",
      "name": "Bengaluru"
    },
    {
      "@type": "City",
      "name": "Mumbai"
    },
    {
      "@type": "City",
      "name": "Delhi NCR"
    }
  ],
  "knowsAbout": [
    "Socratic Method",
    "Quizzing",
    "Quizmastering in India",
    "Critical Thinking for Children",
    "Financial Literacy for Kids",
    "Public Speaking & Debate",
    "Corporate Employee Engagement",
    "Gamified Learning"
  ],
  "founders": [
    {
      "@type": "Person",
      "name": "Sachin Ravi",
      "jobTitle": "Co-Founder & Chief Quizmaster",
      "sameAs": "https://www.linkedin.com/in/sachin-ravi-60b6432b/"
    },
    {
      "@type": "Person",
      "name": "Raghav Chakravarthy",
      "jobTitle": "Co-Founder & Education Innovator",
      "sameAs": "https://www.linkedin.com/in/raghav-chakravarthy-75051a37/"
    }
  ],
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+91-89716-76100",
      "contactType": "customer service",
      "email": "qshala@walnuts.co.in",
      "areaServed": "IN",
      "availableLanguage": ["English", "Hindi", "Kannada"]
    },
    {
      "@type": "ContactPoint",
      "telephone": "+91-89716-76100",
      "contactType": "sales",
      "email": "qshala@walnuts.co.in",
      "areaServed": "IN",
      "availableLanguage": ["English", "Hindi", "Kannada"]
    }
  ],
  "sameAs": [
    "https://twitter.com/qshala",
    "https://www.linkedin.com/company/walnut-knowledge-solutions/",
    "https://www.instagram.com/qshala/",
    "https://www.facebook.com/qshala/",
    "https://www.youtube.com/@qshala"
  ]
};

// WebSite Entity
const websiteEntity: Record<string, any> = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "QShala — India's Quriosity Company",
  "description": "Replacing rote learning with socratic inquiry, storytelling, and wonder across India.",
  "publisher": {
    "@id": `${siteUrl}/#organization`
  },
  "inLanguage": "en-IN"
};

// WebPage Entity
const webPageEntity: Record<string, any> = {
  "@type": pageType,
  "@id": `${canonicalURL}#webpage`,
  "url": canonicalURL,
  "name": title,
  "description": description,
  "isPartOf": {
    "@id": `${siteUrl}/#website`
  },
  "about": {
    "@id": `${siteUrl}/#organization`
  },
  "inLanguage": "en-IN"
};

const graph: Record<string, any>[] = [orgEntity, websiteEntity, webPageEntity];

if (breadcrumbs && breadcrumbs.length > 0) {
  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalURL}#breadcrumb`,
    "itemListElement": breadcrumbs.map((b, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": b.name,
      "item": b.item.startsWith('http') ? b.item : `${siteUrl}${b.item}`
    }))
  });
}

if (schema) {
  if (Array.isArray(schema)) {
    graph.push(...schema);
  } else {
    graph.push(schema);
  }
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": graph
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#30B2E7" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en-IN" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <!-- Robots Directives for Search & AI Answer Engines -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
      </>
    )}

    <!-- Author & Attribution -->
    <meta name="author" content="QShala - Curiosita Educational Services" />
    <meta name="publisher" content="QShala" />
    <meta name="copyright" content="Curiosita Educational Services Pvt. Ltd." />
    <meta name="rating" content="General" />
    <meta name="format-detection" content="telephone=yes" />

    <!-- Open Graph / WhatsApp / Facebook / LinkedIn / iMessage Link Preview -->
    <meta property="og:site_name" content="QShala — India's Quriosity Company" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:locale:alternate" content="en_US" />

    {ogType === 'article' && articleMeta && (
      <>
        {articleMeta.publishedTime && <meta property="article:published_time" content={articleMeta.publishedTime} />}
        {articleMeta.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
        {articleMeta.author && <meta property="article:author" content={articleMeta.author} />}
        {articleMeta.section && <meta property="article:section" content={articleMeta.section} />}
        {articleMeta.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@qshala" />
    <meta name="twitter:creator" content="@qshala" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    <!-- No-JS Fallback for Loader -->
    <noscript>
      <style>
        #loader-root { display: none !important; }
        body { overflow: visible !important; }
        body > *:not(#loader-root) { opacity: 1 !important; visibility: visible !important; }
      </style>
    </noscript>

    <!-- Schema.org JSON-LD Graph for Search Engines, AEO & AI Engines -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    
    <!-- Self-hosted font preloads for optimal performance & zero layout shift -->
    <link rel="preload" href="/fonts/Trustha - Causten Round Black.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Trustha - Causten Round Regular.otf" as="font" type="font/otf" crossorigin />
    <!-- View Transitions Viewport Safety & Error Guard -->
    <script is:inline>
      (function() {
        // Intercept native View Transitions to prevent uncaught InvalidStateError when viewport resizes/aborts
        if (typeof document !== 'undefined' && 'startViewTransition' in document) {
          var origStart = document.startViewTransition.bind(document);
          document.startViewTransition = function(callback) {
            try {
              var vt = origStart(callback);
              if (vt) {
                if (vt.ready && typeof vt.ready.catch === 'function') {
                  vt.ready.catch(function() {});
                }
                if (vt.finished && typeof vt.finished.catch === 'function') {
                  vt.finished.catch(function() {});
                }
                if (vt.updateCallbackDone && typeof vt.updateCallbackDone.catch === 'function') {
                  vt.updateCallbackDone.catch(function() {});
                }
              }
              return vt;
            } catch (err) {
              if (typeof callback === 'function') {
                try { callback(); } catch (e) {}
              }
              return {
                finished: Promise.resolve(),
                ready: Promise.resolve(),
                updateCallbackDone: Promise.resolve(),
                skipTransition: function() {}
              };
            }
          };
        }

        // Defensive global unhandledrejection listener for transition aborts
        window.addEventListener('unhandledrejection', function(event) {
          var reason = event.reason;
          if (
            reason &&
            (reason.name === 'InvalidStateError' ||
             (typeof reason.message === 'string' && reason.message.includes('Transition was aborted')))
          ) {
            event.preventDefault();
          }
        });
      })();
    </script>
    <ClientRouter />

    <!-- Inline script to handle loader logic correctly with View Transitions -->
    <script is:inline>
      (function() {
        try {
          if (!window.hasLoaderShown) {
            document.documentElement.classList.add('loading-active');
            window.hasLoaderShown = true;
          } else {
            document.documentElement.classList.add('skip-loader');
          }

          document.addEventListener('astro:before-swap', function(ev) {
            if (window.hasLoaderShown) {
              ev.newDocument.documentElement.classList.add('skip-loader');
              ev.newDocument.documentElement.classList.remove('loading-active');
            }
          });

          // Ensure proper scroll position restoration on page swap when not targeting an in-page hash
          document.addEventListener('astro:after-swap', function() {
            if (!window.location.hash) {
              window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
            }
          });
        } catch(e) {}
      })();
    </script>
    <style is:global>
      html.skip-loader #loader-root {
        display: none !important;
      }
      html.loading-active body {
        overflow: hidden;
      }
      html.loading-active body > *:not(#loader-root) {
        opacity: 0 !important;
        visibility: hidden !important;
      }

      /* Scroll animations */
      [data-animate="fade-up"] {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      }
      [data-animate="fade-up"].is-visible {
        opacity: 1;
        transform: translateY(0);
      }
    </style>
  </head>
  <body class="antialiased bg-[#FFFDF5] text-black min-h-screen min-h-[100dvh] flex flex-col font-sans">

    <!-- Accessible Skip to Main Content Link -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[10000] focus:px-5 focus:py-2.5 focus:bg-[#FDB913] focus:text-slate-950 focus:font-black focus:rounded-full focus:shadow-md font-heading text-xs uppercase tracking-wider transition-all"
    >
      Skip to main content
    </a>

    <!-- 5-scene Quriosity Loader -->
    <div id="loader-root">
      <LoadingScreen client:load />
    </div>

    <slot />

    <!-- Dynamic Reading Progress Bar -->
    <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-[#30B2E7] z-[9999] origin-left scale-x-0 transition-transform duration-150 ease-out" style="width: 100%;"></div>

    <!-- Scroll Animations & Progress Bar Logic -->
    <script is:inline>
      let isScrollAttached = false;
      document.addEventListener('astro:page-load', () => {
        // 1. Progress Bar Logic
        const bar = document.getElementById('reading-progress');
        const updateProgress = () => {
          const winScroll = window.scrollY;
          const height = document.documentElement.scrollHeight - window.innerHeight;
          const scrolled = height > 0 ? (winScroll / height) : 0;
          if (bar) bar.style.transform = `scaleX(${scrolled})`;
        };
        
        if (!isScrollAttached) {
          window.addEventListener('scroll', updateProgress, { passive: true });
          isScrollAttached = true;
        }
        updateProgress();

        // 2. Scroll-triggered Micro-Animations
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });
        
        document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));
      });
    </script>

    <!-- Pure JS Tab Title Switcher -->
    <script is:inline>
      (function() {
        var originalTitle = document.title;
        var funnyMessages = [
          "QT misses you! Come back!",
          "Still curious? Click back!",
          "Don't leave QT alone with questions!",
          "A wild quiz question appeared!",
          "QT is peeking... Where did you go?"
        ];
        var titleInterval;

        document.addEventListener('astro:page-load', function() {
          if (!document.hidden) {
            originalTitle = document.title;
          }
        });

        document.addEventListener('visibilitychange', function() {
          if (document.hidden) {
            var msg = funnyMessages[Math.floor(Math.random() * funnyMessages.length)];
            document.title = msg;
            titleInterval = setInterval(function() {
              if (document.title !== msg) document.title = msg;
            }, 1000);
          } else {
            clearInterval(titleInterval);
            document.title = originalTitle;
          }
        });
      })();
    </script>
  </body>
</html>
