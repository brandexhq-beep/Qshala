---
import { getNavigation, getSiteSettings } from '../lib/sanity/api';
import { getImageUrl } from '../lib/sanity/image';
import NavbarCartButton from './NavbarCartButton';

const pathname = Astro.url.pathname;
const navData = await getNavigation();
const siteSettings = await getSiteSettings();

const NAV_LINKS = navData.links;
const logoUrl = getImageUrl(siteSettings.logo, '/assets/logos/QShala%20Logo%201.svg');
const ctaLabel = navData.ctaButton?.label || 'Book a Quiz';
const ctaUrl = navData.ctaButton?.url || '/book-a-quiz';

const isLinkActive = (href: string) => {
  if (href === '/') return pathname === '/' || pathname === '';
  return pathname.startsWith(href);
};
---

<header 
  class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/60 shadow-xs transition-all"
  style="padding-top: env(safe-area-inset-top, 0px); padding-left: max(0.5rem, env(safe-area-inset-left, 0px)); padding-right: max(0.5rem, env(safe-area-inset-right, 0px));"
>
  <div class="h-[64px] sm:h-[72px] w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 flex items-center justify-between gap-4">
    <!-- Official QShala SVG Logo -->
    <a 
      href="/" 
      class="flex items-center shrink-0 group cursor-pointer h-9 sm:h-10 max-h-10"
      aria-label="QShala Home"
    >
      <img 
        src={logoUrl} 
        alt="QShala Logo" 
        class="h-8 sm:h-9 max-h-9 w-auto max-w-[150px] sm:max-w-[185px] object-contain transition-transform group-hover:scale-105" 
        style="height: 36px !important; max-height: 36px !important; width: auto !important; max-width: 180px !important; object-fit: contain; display: block;"
        width="166"
        height="36"
        loading="eager"
      />
    </a>

    <!-- Desktop Navigation Links Bar -->
    <nav 
      class="hidden lg:flex items-center gap-4 xl:gap-7 font-black text-xs xl:text-sm text-slate-800 tracking-tight font-heading"
      aria-label="Primary Navigation"
    >
      {NAV_LINKS.map((link) => {
        const active = isLinkActive(link.href);
        return (
          <a 
            href={link.href} 
            data-nav-href={link.href}
            data-astro-prefetch="hover" 
            class={`relative py-1 whitespace-nowrap transition-colors ${
              active 
                ? 'text-[#30B2E7] after:w-full' 
                : 'hover:text-[#30B2E7] after:w-0 hover:after:w-full'
            } after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:bg-[#30B2E7] after:transition-all after:duration-300`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Desktop Action CTA & Cart Button -->
    <div class="hidden lg:flex items-center gap-3 shrink-0">
      <NavbarCartButton client:load />
      <a
        href={ctaUrl}
        data-astro-prefetch="hover"
        class="whitespace-nowrap px-4 py-2 sm:px-5 sm:py-2.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs sm:text-sm shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all font-heading"
      >
        {ctaLabel}
      </a>
    </div>

    <!-- Mobile Header Actions (Cart + Hamburger) -->
    <div class="flex lg:hidden items-center gap-2 shrink-0">
      <NavbarCartButton client:load />
      <button
        id="menuToggleBtn"
        class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-slate-100 text-slate-900 border border-slate-200 flex items-center justify-center cursor-pointer shadow-sm hover:bg-slate-200 active:scale-95 transition-all shrink-0"
        aria-label="Toggle Mobile Menu"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <svg id="menuIconHamburger" class="w-5 h-5 fill-current text-slate-900" viewBox="0 0 24 24">
          <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
        </svg>
        <svg id="menuIconClose" class="w-5 h-5 fill-current text-slate-900 hidden" viewBox="0 0 24 24">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Panel (Properly absolute-positioned across full width) -->
  <div
    id="mobileMenu"
    class="hidden lg:hidden absolute top-full left-0 right-0 w-full bg-white/98 backdrop-blur-xl border-b border-slate-200 shadow-2xl px-4 py-4 sm:px-6 max-h-[calc(100dvh-4.5rem)] overflow-y-auto scroll-touch"
  >
    <div class="flex flex-col gap-2 font-black text-slate-900 font-heading text-sm max-w-lg mx-auto">
      {NAV_LINKS.map((link) => {
        const active = isLinkActive(link.href);
        return (
          <a
            href={link.href}
            data-nav-href={link.href}
            class={`px-4 py-3 min-h-[48px] rounded-2xl flex items-center justify-between transition-all ${
              active
                ? 'bg-[#30B2E7] text-white shadow-sm font-black'
                : 'text-slate-800 hover:bg-slate-50 font-bold'
            }`}
          >
            <span>{link.name}</span>
            <span class={`mobile-active-badge px-2.5 py-0.5 rounded-full bg-[#FDB913] text-slate-950 font-black text-[10px] uppercase tracking-wider font-heading shadow-sm ${active ? '' : 'hidden'}`}>
              Active
            </span>
          </a>
        );
      })}

      <a
        href={ctaUrl}
        class="mt-2 text-center py-3.5 min-h-[48px] rounded-2xl bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black shadow-sm uppercase tracking-wider text-xs font-heading flex items-center justify-center transition-all"
      >
        {ctaLabel} &rarr;
      </a>
    </div>
  </div>
</header>

<script>
  function highlightActiveRoute() {
    const rawPath = window.location.pathname;
    const currentPath = rawPath.endsWith('/') && rawPath.length > 1 ? rawPath.slice(0, -1) : rawPath;

    // 1. Mobile Menu Highlighting
    const mobileLinks = document.querySelectorAll('#mobileMenu a[data-nav-href]');
    mobileLinks.forEach((link) => {
      const href = link.getAttribute('data-nav-href');
      const badge = link.querySelector('.mobile-active-badge');
      const isCurrent = href === '/' 
        ? (currentPath === '/' || currentPath === '') 
        : currentPath.startsWith(href || '');

      if (isCurrent) {
        link.className = "px-4 py-3 min-h-[48px] rounded-2xl flex items-center justify-between transition-all bg-[#30B2E7] text-white shadow-sm font-black";
        badge?.classList.remove('hidden');
      } else {
        link.className = "px-4 py-3 min-h-[48px] rounded-2xl flex items-center justify-between transition-all text-slate-800 hover:bg-slate-50 font-bold";
        badge?.classList.add('hidden');
      }
    });

    // 2. Desktop Nav Highlighting
    const desktopLinks = document.querySelectorAll('header nav a[data-nav-href]');
    desktopLinks.forEach((link) => {
      const href = link.getAttribute('data-nav-href');
      const isCurrent = href === '/' 
        ? (currentPath === '/' || currentPath === '') 
        : currentPath.startsWith(href || '');

      if (isCurrent) {
        link.classList.add('text-[#30B2E7]');
        link.classList.remove('text-slate-900');
      } else {
        link.classList.remove('text-[#30B2E7]');
        link.classList.add('text-slate-900');
      }
    });
  }

  let outsideClickHandler: ((e: MouseEvent) => void) | null = null;

  function setupMenuToggle() {
    const menuToggleBtn = document.getElementById('menuToggleBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const hamburgerIcon = document.getElementById('menuIconHamburger');
    const closeIcon = document.getElementById('menuIconClose');

    if (outsideClickHandler) {
      document.removeEventListener('click', outsideClickHandler);
      outsideClickHandler = null;
    }

    if (menuToggleBtn && mobileMenu) {
      const setMenuOpen = (open: boolean) => {
        menuToggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) {
          mobileMenu.classList.remove('hidden');
          hamburgerIcon?.classList.add('hidden');
          closeIcon?.classList.remove('hidden');
        } else {
          mobileMenu.classList.add('hidden');
          hamburgerIcon?.classList.remove('hidden');
          closeIcon?.classList.add('hidden');
        }
      };

      menuToggleBtn.onclick = (e) => {
        e.stopPropagation();
        const isExpanded = menuToggleBtn.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!isExpanded);
      };

      // Auto-close dropdown when a navigation link is clicked
      const menuLinks = mobileMenu.querySelectorAll('a');
      menuLinks.forEach((link) => {
        link.onclick = () => {
          setMenuOpen(false);
          const href = link.getAttribute('href') || link.getAttribute('data-nav-href');
          if (href && (href === window.location.pathname || href === window.location.pathname.replace(/\/+$/, ''))) {
            window.scrollTo({ top: 0, left: 0, behavior: 'smooth' });
          }
        };
      });

      outsideClickHandler = (e: MouseEvent) => {
        if (!mobileMenu.contains(e.target as Node) && !menuToggleBtn.contains(e.target as Node)) {
          setMenuOpen(false);
        }
      };

      document.addEventListener('click', outsideClickHandler);
    }
  }

  highlightActiveRoute();
  setupMenuToggle();

  document.addEventListener('astro:page-load', () => {
    highlightActiveRoute();
    setupMenuToggle();
  });
</script>
