---
import { getTestimonials } from '../lib/sanity/api';

const cmsTestimonials = await getTestimonials();

const TYPE_THEMES: Record<string, { accent: string; bg: string }> = {
  Corporate: { accent: '#FDB913', bg: '#FFF8E1' },
  Parent: { accent: '#30B2E7', bg: '#E8F6FD' },
  School: { accent: '#75B543', bg: '#EDF7E5' },
  College: { accent: '#30B2E7', bg: '#E8F6FD' },
};

const testimonials = cmsTestimonials.map(t => {
  const typeStr = t.type || 'School';
  const theme = TYPE_THEMES[typeStr] || TYPE_THEMES.School;
  const initials = t.initials || t.author.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();

  return {
    author: t.author,
    role: t.role || '',
    org: t.organization || '',
    type: typeStr,
    quote: t.quote,
    stars: t.rating || 5,
    accent: t.accentColor || theme.accent,
    bg: t.bgColor || theme.bg,
    initials
  };
});
---

<section id="testimonials" class="py-14 bg-[#FFFDF5] border-t-2 border-b-2 border-slate-200/80 relative">
  
  <!-- Header (Subtitle removed as requested) -->
  <div class="max-w-7xl mx-auto px-6 mb-8 sm:mb-12 text-center space-y-3">
    <span class="inline-block px-4 py-1.5 rounded-full bg-[#FDB913] text-black font-black text-xs uppercase tracking-wider border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] font-heading">
      Wall of Love
    </span>
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight font-heading">
      What Educators, Leaders &amp; Parents Say
    </h2>
  </div>

  <!-- Single Row Layout -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="relative">
      <div 
        id="testimonialsTrack"
        class="flex gap-4 sm:gap-6 overflow-x-auto scrollbar-none py-4 snap-x snap-mandatory px-1 scroll-smooth"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {testimonials.map((item, idx) => (
          <div 
            id={`testimonial-card-${idx}`}
            class="testimonial-card w-[82vw] max-w-[320px] sm:w-[350px] md:w-[380px] shrink-0 snap-start"
            style={`--accent: ${item.accent}; --bg: ${item.bg};`}
          >
            <!-- Stars & Type Badge -->
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-1 text-amber-400">
                {Array.from({ length: item.stars }).map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-white border border-slate-300 text-slate-800 font-heading">
                {item.type}
              </span>
            </div>

            <!-- Quote -->
            <p class="text-slate-800 text-sm font-semibold leading-relaxed mb-6 flex-grow font-sans italic">
              &ldquo;{item.quote}&rdquo;
            </p>

            <!-- Author Info -->
            <div class="flex items-center gap-3 pt-3 border-t border-slate-900/10 mt-auto">
              <div 
                class="w-9 h-9 rounded-full flex items-center justify-center font-black text-xs text-slate-950 border-2 border-black flex-shrink-0 font-heading"
                style={`background-color: ${item.accent};`}
              >
                {item.initials}
              </div>
              <div class="min-w-0">
                <div class="font-black text-xs text-slate-900 truncate font-heading">{item.author}</div>
                <div class="text-[10px] text-slate-600 font-medium truncate">{item.role}, <span class="font-semibold text-slate-800">{item.org}</span></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile & Tablet Scroll Indicator and Controls -->
    <div class="flex items-center justify-between pt-3 px-2">
      <div class="flex items-center gap-1" id="testimonialsDots">
        {testimonials.map((_, idx) => (
          <button
            type="button"
            data-index={idx}
            aria-label={`Go to testimonial ${idx + 1}`}
            class="testimonial-dot min-w-[32px] min-h-[32px] p-1.5 flex items-center justify-center cursor-pointer"
          >
            <span class={`dot-pill block h-2.5 rounded-full transition-all ${
              idx === 0 ? 'w-6 bg-[#0284C7]' : 'w-2.5 bg-slate-400'
            }`} />
          </button>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <button
          id="testimonialPrevBtn"
          type="button"
          aria-label="Previous testimonial"
          class="w-10 h-10 min-w-[40px] min-h-[40px] rounded-full border-2 border-black bg-white hover:bg-slate-100 text-slate-900 flex items-center justify-center shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:scale-95 transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="testimonialNextBtn"
          type="button"
          aria-label="Next testimonial"
          class="w-10 h-10 min-w-[40px] min-h-[40px] rounded-full border-2 border-black bg-[#FDB913] hover:bg-amber-400 text-black flex items-center justify-center shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:scale-95 transition-all cursor-pointer"
        >
          <svg class="w-4 h-4 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

</section>

<script>
  let autoTimer: any = null;

  function stopAutoScroll() {
    if (autoTimer) {
      clearInterval(autoTimer);
      autoTimer = null;
    }
  }

  function setupTestimonials() {
    stopAutoScroll();
    const track = document.getElementById('testimonialsTrack');
    const prevBtn = document.getElementById('testimonialPrevBtn');
    const nextBtn = document.getElementById('testimonialNextBtn');
    const dots = document.querySelectorAll('.testimonial-dot');

    if (!track) return;

    let isPaused = false;

    function getStep() {
      const card = track.firstElementChild;
      return (card?.clientWidth || 320) + 24;
    }

    function scrollNext() {
      const step = getStep();
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (track.scrollLeft >= maxScroll - 15) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: step, behavior: 'smooth' });
      }
    }

    function scrollPrev() {
      const step = getStep();
      if (track.scrollLeft <= 15) {
        track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: -step, behavior: 'smooth' });
      }
    }

    function startAutoScroll() {
      stopAutoScroll();
      autoTimer = setInterval(() => {
        if (!isPaused) {
          scrollNext();
        }
      }, 4000);
    }

    function updateDots() {
      const step = getStep();
      const scrollPos = track.scrollLeft;
      const activeIdx = Math.min(Math.round(scrollPos / step), dots.length - 1);

      dots.forEach((dot, idx) => {
        const pill = dot.querySelector('.dot-pill');
        if (pill) {
          if (idx === activeIdx) {
            pill.className = "dot-pill block h-2.5 w-6 rounded-full transition-all bg-[#0284C7]";
          } else {
            pill.className = "dot-pill block h-2.5 w-2.5 rounded-full transition-all bg-slate-400";
          }
        }
      });
    }

    track.addEventListener('scroll', updateDots, { passive: true });

    track.addEventListener('mouseenter', () => { isPaused = true; });
    track.addEventListener('mouseleave', () => { isPaused = false; });
    track.addEventListener('touchstart', () => { isPaused = true; }, { passive: true });
    track.addEventListener('touchend', () => { isPaused = false; });

    prevBtn?.addEventListener('click', () => {
      scrollPrev();
      startAutoScroll();
    });

    nextBtn?.addEventListener('click', () => {
      scrollNext();
      startAutoScroll();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.getAttribute('data-index') || 0);
        const card = document.getElementById(`testimonial-card-${idx}`);
        if (card) {
          card.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        }
        startAutoScroll();
      });
    });

    startAutoScroll();
  }

  document.addEventListener('astro:page-load', setupTestimonials);
  document.addEventListener('astro:before-swap', stopAutoScroll);
</script>

<style>
  .testimonial-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 220px;
    padding: 24px;
    border-radius: 24px;
    border: 2px solid #0f172a;
    background: var(--bg, #white);
    box-shadow: 4px 4px 0px 0px rgba(0, 0, 0, 1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: default;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 6px 6px 0px 0px rgba(0, 0, 0, 1);
  }
</style>
