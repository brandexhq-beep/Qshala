---
// ClientMarquee.astro — QShala brand-aligned marquee of clients/partners
import { getPartners } from '../lib/sanity/api';
import { getImageUrl } from '../lib/sanity/image';

const cmsPartners = await getPartners();

const DEFAULT_ROW1 = [
  { name: "Google", category: "Tech", color: "#30B2E7", bg: "#E8F6FD", logo: "google.svg" },
  { name: "HDFC Bank", category: "Finance", color: "#FDB913", bg: "#FFF8E1", logo: "hdfcbank.svg" },
  { name: "Wipro", category: "Tech", color: "#75B543", bg: "#EDF7E5", logo: "wipro.svg" },
  { name: "Microsoft", category: "Tech", color: "#30B2E7", bg: "#E8F6FD", logo: "microsoft.svg" },
  { name: "Tata Group", category: "Enterprise", color: "#FDB913", bg: "#FFF8E1", logo: "tatagroup.svg" },
  { name: "Amazon", category: "E-Commerce", color: "#75B543", bg: "#EDF7E5", logo: "amazon.svg" },
];

const DEFAULT_ROW2 = [
  { name: "Infosys", category: "Tech", color: "#30B2E7", bg: "#E8F6FD", logo: "infosys.svg" },
  { name: "Netflix", category: "Entertainment", color: "#FDB913", bg: "#FFF8E1", logo: "netflix.svg" },
  { name: "Apple", category: "Consumer Tech", color: "#75B543", bg: "#EDF7E5", logo: "apple.svg" },
  { name: "Byju's", category: "EdTech", color: "#30B2E7", bg: "#E8F6FD", logo: "byjus.svg" },
  { name: "Facebook", category: "Social Media", color: "#FDB913", bg: "#FFF8E1", logo: "facebook.svg" },
  { name: "Intel", category: "Hardware", color: "#75B543", bg: "#EDF7E5", logo: "intel.svg" },
];

// Set of verified local logos in public/assets/logos/
const LOCAL_LOGOS = new Set([
  'google.svg', 'hdfcbank.svg', 'wipro.svg', 'microsoft.svg', 'tatagroup.svg', 'amazon.svg',
  'infosys.svg', 'netflix.svg', 'apple.svg', 'byjus.svg', 'facebook.svg', 'intel.svg',
  'zerodha.svg', 'mindtree.svg', 'tatamotors.svg', 'oracle.svg', 'qwikcilver.svg',
  'lowelintas.webp', 'uptycs.webp'
]);

function resolveLogoUrl(p: any): string | null {
  if (p.logo) {
    return getImageUrl(p.logo, 200, 100);
  }
  if (p.logoUrl && typeof p.logoUrl === 'string' && p.logoUrl.trim()) {
    if (p.logoUrl.startsWith('http://') || p.logoUrl.startsWith('https://')) {
      return p.logoUrl;
    }
    const cleanPath = p.logoUrl.replace(/^\/assets\/logos\//, '');
    if (LOCAL_LOGOS.has(cleanPath)) {
      return `/assets/logos/${cleanPath}`;
    }
  }
  const normalizedSvg = `${p.name?.toLowerCase().replace(/[^a-z0-9]/g, '')}.svg`;
  if (LOCAL_LOGOS.has(normalizedSvg)) {
    return `/assets/logos/${normalizedSvg}`;
  }
  return null;
}

// If CMS has custom partners, use them, otherwise fallback to defaults
const hasCmsPartners = cmsPartners && cmsPartners.length >= 6;
const activeList1 = hasCmsPartners 
  ? cmsPartners.slice(0, Math.ceil(cmsPartners.length / 2)).map(p => ({
      name: p.name,
      category: p.category || 'Partner',
      color: "#30B2E7",
      bg: "#E8F6FD",
      logoUrl: resolveLogoUrl(p)
    }))
  : DEFAULT_ROW1.map(p => ({ ...p, logoUrl: `/assets/logos/${p.logo}` }));

const activeList2 = hasCmsPartners 
  ? cmsPartners.slice(Math.ceil(cmsPartners.length / 2)).map(p => ({
      name: p.name,
      category: p.category || 'Partner',
      color: "#FDB913",
      bg: "#FFF8E1",
      logoUrl: resolveLogoUrl(p)
    }))
  : DEFAULT_ROW2.map(p => ({ ...p, logoUrl: `/assets/logos/${p.logo}` }));

const row1 = [...activeList1, ...activeList1, ...activeList1];
const row2 = [...activeList2, ...activeList2, ...activeList2];
---

<section class="py-12 bg-white overflow-hidden">

  <!-- Header -->
  <div class="max-w-7xl mx-auto px-6 mb-12 text-center">
    <span class="inline-block px-4 py-1.5 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-xs">
      Trusted by the Best
    </span>
    <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight mt-4 font-heading">
      Brands That Choose Quriosity.
    </h2>
  </div>

  <!-- Row 1: Left scroll -->
  <div class="marquee-container mb-4" id="marquee-row-1">
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-10 sm:w-20 md:w-32 z-10 bg-gradient-to-r from-white to-transparent"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-10 sm:w-20 md:w-32 z-10 bg-gradient-to-l from-white to-transparent"></div>
    <div class="marquee-track scroll-left flex gap-5 w-max">
      {row1.map((client) => (
        <div class="client-card" style={`--accent: ${client.color}; --bg: ${client.bg};`}>
          <div class="client-card-logo-wrapper">
            <div class="client-card-badge">
              {client.name[0]}
            </div>
            {client.logoUrl && (
              <img
                src={client.logoUrl}
                alt={`${client.name} logo`}
                class="client-logo"
                style="opacity: 0; transition: opacity 0.2s;"
                loading="lazy"
                onload="this.style.opacity='1';"
                onerror="this.style.display='none';"
              />
            )}
          </div>
          <div class="client-card-body">
            <div class="client-card-name">{client.name}</div>
            <div class="client-card-cat">{client.category}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Row 2: Right scroll -->
  <div class="marquee-container" id="marquee-row-2">
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-10 sm:w-20 md:w-32 z-10 bg-gradient-to-r from-white to-transparent"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-10 sm:w-20 md:w-32 z-10 bg-gradient-to-l from-white to-transparent"></div>
    <div class="marquee-track scroll-right flex gap-5 w-max">
      {row2.map((client) => (
        <div class="client-card" style={`--accent: ${client.color}; --bg: ${client.bg};`}>
          <div class="client-card-logo-wrapper">
            <div class="client-card-badge">
              {client.name[0]}
            </div>
            {client.logoUrl && (
              <img
                src={client.logoUrl}
                alt={`${client.name} logo`}
                class="client-logo"
                style="opacity: 0; transition: opacity 0.2s;"
                loading="lazy"
                onload="this.style.opacity='1';"
                onerror="this.style.display='none';"
              />
            )}
          </div>
          <div class="client-card-body">
            <div class="client-card-name">{client.name}</div>
            <div class="client-card-cat">{client.category}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Stats strip -->
  <div class="max-w-4xl mx-auto px-6 mt-14">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      {[
        { value: "250+", label: "Schools Partnered", color: "#0284C7", bg: "#E8F6FD" },
        { value: "80+",  label: "Corporate Clients",  color: "#0284C7", bg: "#E8F6FD" },
        { value: "18+",  label: "Cities Covered",     color: "#0284C7", bg: "#E8F6FD" },
      ].map((stat) => (
        <div
          class="flex flex-col items-center justify-center py-6 px-4 rounded-2xl border border-slate-200/80 shadow-xs text-center transition-all hover:-translate-y-1 hover:shadow-md"
          style={`background-color: ${stat.bg};`}
        >
          <span class="text-3xl font-black font-heading" style={`color: ${stat.color}`}>{stat.value}</span>
          <span class="text-[11px] font-black uppercase tracking-wider text-slate-700 mt-1">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Keyframes ── */
  @keyframes scroll-left {
    0%   { transform: translateX(0); }
    100% { transform: translateX(calc(-100% / 3)); }
  }

  @keyframes scroll-right {
    0%   { transform: translateX(calc(-100% / 3)); }
    100% { transform: translateX(0); }
  }

  /* ── Container ── */
  .marquee-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 8px 0;
  }

  /* ── Tracks ── */
  .marquee-track {
    display: flex;
    gap: 20px;
    width: max-content;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .scroll-left {
    animation: scroll-left 28s linear infinite;
  }

  .scroll-right {
    animation: scroll-right 22s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-left,
    .scroll-right {
      animation: none !important;
    }
    .marquee-container {
      overflow-x: auto;
      scrollbar-width: none;
    }
  }

  /* ── Pause on hover (applied to the container, affects the track inside) ── */
  .marquee-container:hover .scroll-left,
  .marquee-container:hover .scroll-right {
    animation-play-state: paused;
  }

  /* ── Cards ── */
  .client-card {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    border-radius: 18px;
    border: 2.5px solid var(--accent);
    background: var(--bg);
    box-shadow: 4px 4px 0px 0px rgba(0, 0, 0, 0.9);
    min-width: 210px;
    cursor: default;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .client-card:hover {
    transform: translateY(-3px);
    box-shadow: 6px 6px 0px 0px rgba(0, 0, 0, 0.9);
  }

  .client-card-logo-wrapper {
    position: relative;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .client-logo {
    position: absolute;
    inset: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 2px solid black;
    background-color: white;
    object-fit: contain;
    padding: 6px;
    z-index: 10;
    box-sizing: border-box;
  }

  .client-card-badge {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background-color: var(--accent);
    border: 2px solid black;
    font-weight: 900;
    font-size: 18px;
    color: white;
    letter-spacing: -0.5px;
    z-index: 5;
  }

  .client-card-body {
    display: flex;
    flex-direction: column;
  }

  .client-card-name {
    font-weight: 900;
    font-size: 14px;
    color: #0f172a;
    white-space: nowrap;
    line-height: 1.2;
    font-family: var(--font-heading, sans-serif);
  }

  .client-card-cat {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #334155;
    margin-top: 3px;
  }
</style>
