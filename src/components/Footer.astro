---
import { getFooter, getSiteSettings } from '../lib/sanity/api';

const footerData = await getFooter();
const siteSettings = await getSiteSettings();

const bannerBadge = footerData.bannerBadge || 'Joy of Quest';
const bannerHeading = footerData.bannerHeading || 'Ready to replace rote learning with quriosity?';
const bannerDescription = footerData.bannerDescription || 'Partner with our team for consultative school programs, corporate trivia offsites, or custom quests.';
const bannerCtaText = footerData.bannerCtaText || 'Talk to us →';
const bannerCtaUrl = footerData.bannerCtaUrl || '/contact';

const companyName = footerData.companyName || siteSettings.brandName || 'Walnut Knowledge Solutions';
const companyDesc = footerData.companyDescription || 'QShala is India\'s quriosity learning platform built by Walnut Knowledge Solutions.';
const phone = siteSettings.contactPhone || '+91 89716 76100';
const email = siteSettings.contactEmail || 'qshala@walnuts.co.in';
const address = siteSettings.officeAddress || '1st Floor, 680, Fortuna 1, 8th Main Road, 14th Cross Road, Near Delmia Circle, 3rd Phase, J.P. Nagar, Bengaluru, Karnataka - 560078';
const mapsUrl = siteSettings.googleMapsUrl || 'https://maps.google.com/?q=Walnut+Knowledge+Solutions+JP+Nagar+Bengaluru';
const copyright = footerData.copyrightText || `© ${new Date().getFullYear()} Walnut Knowledge Solutions (QShala). All rights reserved.`;
---

<footer 
  class="relative bg-slate-950 text-white rounded-t-[2.5rem] sm:rounded-t-[3rem] pt-8 sm:pt-12 md:pt-16 pb-12 overflow-hidden mt-8 md:mt-12 border-t-4 border-[#FDB913]"
  style="padding-bottom: max(3rem, calc(2rem + env(safe-area-inset-bottom, 0px)));"
>
  <div class="w-full px-4 sm:px-6 md:px-12 relative z-10">

    <!-- Top Banner with Joy of Quest Yellow -->
    <div class="bg-[#FDB913] rounded-3xl p-5 sm:p-8 md:p-12 mb-8 sm:mb-14 flex flex-col md:flex-row items-center justify-between shadow-xl relative overflow-hidden text-center md:text-left gap-5 sm:gap-6">
      <div class="max-w-xl">
        <span class="inline-block px-3.5 py-1 sm:px-4 sm:py-1.5 bg-black text-white rounded-full text-[10px] sm:text-xs font-black uppercase tracking-wider mb-2 sm:mb-3 font-heading shadow-sm">
          {bannerBadge}
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-5xl font-black tracking-tight text-slate-900 leading-tight font-heading">
          {bannerHeading}
        </h2>
        <p class="text-slate-900 font-bold text-xs sm:text-base mt-2 leading-relaxed">
          {bannerDescription}
        </p>
      </div>

      <div class="flex flex-col items-center gap-3 sm:gap-4 shrink-0 w-full sm:w-auto">
        <!-- Responsive Mascot: single responsive SVG image avoiding island duplication -->
        <img
          src="/assets/qt/QT Idea.svg"
          alt="QT Mascot Idea"
          width="112"
          height="112"
          class="w-20 h-20 sm:w-28 sm:h-28 object-contain pointer-events-none drop-shadow-md shrink-0"
          loading="lazy"
        />
        <a
          href={bannerCtaUrl}
          class="w-full sm:w-auto px-7 sm:px-8 py-3 sm:py-3.5 bg-slate-950 hover:bg-slate-900 text-white font-black rounded-full shadow-lg hover:scale-105 active:scale-95 transition-all text-xs sm:text-base font-heading text-center min-h-[44px] flex items-center justify-center"
        >
          {bannerCtaText}
        </a>
      </div>
    </div>

    <!-- Footer Navigation & Contact Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 sm:gap-10 pb-8 sm:pb-12 border-b border-slate-800">
      
      <!-- Walnut Knowledge Solutions Legal Entity & Address -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <img
            src="/assets/logos/QShala Logo 1 W.svg"
            alt="QShala Logo"
            width="150"
            height="36"
            class="h-8 sm:h-9 w-auto max-w-[150px] object-contain"
            style="height: 36px; width: auto; max-width: 150px; display: block;"
            loading="lazy"
          />
        </a>

        <div class="space-y-1">
          <h3 class="text-lg font-black text-white font-heading">{companyName}</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            {companyDesc}
          </p>
        </div>

        <!-- Call & Location with Phone Icon & Building Icon -->
        <div class="space-y-4 text-xs text-slate-300 pt-2 font-medium">
          
          <!-- Call Us with Phone SVG Icon -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-slate-900 border border-slate-700 flex items-center justify-center text-[#FDB913] shrink-0 shadow-sm">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
              </svg>
            </div>
            <div>
              <span class="block text-slate-400 text-[11px] font-bold uppercase tracking-wider font-heading">Call Us</span>
              <a href={`tel:${phone.replace(/\s+/g, '')}`} class="text-white font-black hover:text-[#FDB913] text-sm font-heading">{phone}</a>
            </div>
          </div>

          <!-- Visit Us with Location / Building Pin SVG Icon -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-slate-900 border border-slate-700 flex items-center justify-center text-[#30B2E7] shrink-0 shadow-sm">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
            </div>
            <div>
              <span class="block text-slate-400 text-[11px] font-bold uppercase tracking-wider font-heading">Visit Us</span>
              <p class="text-slate-300 leading-relaxed font-semibold">
                {address}
              </p>
              <a 
                href={mapsUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 mt-1.5 text-[#30B2E7] hover:underline font-black text-xs uppercase tracking-wider font-heading"
              >
                <span>VIEW ON MAP</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- Connect Column (WhatsApp Community Button + Horizontal Social Logos Row) -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4 font-heading">Connect</h3>
        
        <div class="space-y-4">
          <!-- Official Green WhatsApp Community Badge -->
          <a 
            href="https://chat.whatsapp.com/QShalaQuriosityCommunity" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full px-4 py-3 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-slate-950 font-black text-xs flex items-center justify-center gap-2.5 transition-all font-heading shadow-md border border-black/20 hover:scale-102 active:scale-95 min-h-[44px]"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984 0 1.76.459 3.477 1.33 4.992l-1.413 5.161 5.279-1.385c1.454.793 3.097 1.213 4.79 1.214h.004c5.505 0 9.989-4.478 9.99-9.984 0-2.668-1.038-5.176-2.925-7.062-1.887-1.886-4.394-2.924-7.065-2.924zm5.834 14.162c-.247.692-1.433 1.332-1.988 1.413-.505.074-1.157.106-3.72-.949-3.056-1.258-5.025-4.364-5.177-4.567-.152-.203-1.233-1.638-1.233-3.125 0-1.487.778-2.219 1.056-2.522.278-.303.606-.378.808-.378.202 0 .404.002.581.01.189.008.441-.072.693.53.252.602.859 2.096.934 2.247.075.152.126.329.025.53-.101.202-.152.329-.303.505-.152.177-.32.395-.456.53-.152.152-.311.317-.134.62.177.303.787 1.298 1.687 2.101 1.157 1.031 2.132 1.35 2.434 1.498.303.148.48.126.657-.076.177-.202.757-.883.959-1.186.202-.303.404-.253.682-.152.278.101 1.767.833 2.07 1.01.303.177.505.265.581.391.075.127.075.733-.172 1.425z"/>
            </svg>
            <span>Join WhatsApp Community</span>
          </a>

          <!-- Horizontal Social Media Logos Row (Single Line on Desktop, Wrap on Mobile) -->
          <div class="flex items-center gap-2 pt-1 flex-wrap">
            
            <!-- Instagram -->
            <a 
              href="https://www.instagram.com/qshala/" 
              target="_blank" 
              rel="noopener noreferrer"
              aria-label="Instagram"
              title="Instagram"
              class="w-9 h-9 sm:w-10 sm:h-10 min-w-[36px] min-h-[36px] rounded-xl bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 text-white flex items-center justify-center shadow-md hover:scale-110 transition-transform border border-white/20 shrink-0"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>

            <!-- Facebook -->
            <a 
              href="https://www.facebook.com/qshala/" 
              target="_blank" 
              rel="noopener noreferrer"
              aria-label="Facebook"
              title="Facebook"
              class="w-9 h-9 sm:w-10 sm:h-10 min-w-[36px] min-h-[36px] rounded-xl bg-[#1877F2] text-white flex items-center justify-center shadow-md hover:scale-110 transition-transform border border-white/20 shrink-0"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>

            <!-- Twitter / X -->
            <a 
              href="https://twitter.com/qshala" 
              target="_blank" 
              rel="noopener noreferrer"
              aria-label="Twitter / X"
              title="Twitter / X"
              class="w-9 h-9 sm:w-10 sm:h-10 min-w-[36px] min-h-[36px] rounded-xl bg-slate-900 border border-slate-700 text-white flex items-center justify-center shadow-md hover:scale-110 transition-transform shrink-0"
            >
              <span class="font-black text-xs font-heading">𝕏</span>
            </a>

            <!-- LinkedIn -->
            <a 
              href="https://www.linkedin.com/company/walnut-knowledge-solutions/" 
              target="_blank" 
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              title="LinkedIn"
              class="w-9 h-9 sm:w-10 sm:h-10 min-w-[36px] min-h-[36px] rounded-xl bg-[#0A66C2] text-white flex items-center justify-center shadow-md hover:scale-110 transition-transform border border-white/20 shrink-0"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>

            <!-- YouTube -->
            <a 
              href="https://www.youtube.com/@qshala" 
              target="_blank" 
              rel="noopener noreferrer"
              aria-label="YouTube"
              title="YouTube"
              class="w-9 h-9 sm:w-10 sm:h-10 min-w-[36px] min-h-[36px] rounded-xl bg-[#FF0000] text-white flex items-center justify-center shadow-md hover:scale-110 transition-transform border border-white/20 shrink-0"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            <!-- Write to us! -->
            <a 
              href={`mailto:${email}`} 
              aria-label="Write to us!"
              title={`Write to us! (${email})`}
              class="w-9 h-9 sm:w-10 sm:h-10 min-w-[36px] min-h-[36px] rounded-xl bg-[#FDB913] text-slate-950 flex items-center justify-center shadow-md hover:scale-110 transition-transform border border-black/20 shrink-0"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            </a>

          </div>
        </div>
      </div>

      <!-- Work With Us! Careers Column -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4 font-heading">Work With Us!</h3>
        <div class="space-y-3">
          <p class="text-slate-400 text-xs leading-relaxed">
            For career inquiries, write to us at:
          </p>
          <a 
            href="mailto:work@walnuts.co.in" 
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-[#FDB913] font-black text-xs border border-slate-700 font-heading hover:border-[#FDB913] transition-all shadow-sm"
          >
            <svg class="w-4 h-4 fill-current shrink-0 text-[#FDB913]" viewBox="0 0 24 24">
              <path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/>
            </svg>
            <span>work@walnuts.co.in</span>
          </a>
        </div>

        <div class="pt-6">
          <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2 font-heading">Explore</h4>
          <ul class="space-y-2 text-xs text-slate-400 font-medium">
            <li><a href="/schools" class="hover:text-white">For Schools</a></li>
            <li><a href="/companies" class="hover:text-white">For Corporates</a></li>
            <li><a href="/archive" class="hover:text-white">Archive / Past Events</a></li>
            <li><a href="/shop" class="hover:text-white">Quriosity Store</a></li>
          </ul>
        </div>
      </div>

      <!-- Company & Legal -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4 font-heading">Company</h3>
        <ul class="space-y-2.5 text-sm text-slate-400 font-medium">
          <li><a href="/about" class="hover:text-white">About Our Mission</a></li>
          <li><a href="/team" class="hover:text-[#30B2E7]">Meet the Team</a></li>
          <li><a href="/archive" class="hover:text-[#FDB913]">Archive / Past Events</a></li>
          <li><a href="/case-studies" class="hover:text-[#30B2E7]">Impact &amp; Case Studies</a></li>
          <li><a href="/blog" class="hover:text-white">Blog</a></li>
          <li><a href="/contact" class="hover:text-[#FDB913]">Contact Us</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Legal Policy Links -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 font-medium gap-4 text-center sm:text-left">
      <p>{copyright}</p>
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 font-heading font-black">
        <a href="/terms-and-conditions" class="hover:text-white transition-colors">Terms and Conditions</a>
        <span>|</span>
        <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
