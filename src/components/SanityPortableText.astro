---
import { toHTML } from '@portabletext/to-html';
import { getImageUrl } from '../lib/sanity/image';

interface Props {
  value: any;
  class?: string;
}

const { value, class: className = '' } = Astro.props;

let html = '';

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

/**
 * Sanitizes raw HTML strings according to modern-web-guidance
 * Strips XSS vectors (scripts, inline events, unsafe schemes) while preserving
 * standard typography tags (p, h1-h6, ul, ol, li, blockquote, a, img, strong, em).
 */
function sanitizeHtmlContent(raw: string): string {
  if (!raw) return '';
  const trimmed = raw.trim();

  // If the input is plain text without any HTML tags, wrap cleanly in paragraphs
  if (!/<[a-z][\s\S]*>/i.test(trimmed)) {
    return trimmed
      .split(/\n\s*\n/)
      .map(p => `<p class="text-base sm:text-lg text-slate-700 leading-relaxed font-medium mb-5">${escapeHtml(p.trim())}</p>`)
      .join('');
  }

  // Strip dangerous elements
  let clean = trimmed
    .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
    .replace(/<style\b[^<]*(?:(?!<\/style>)<[^<]*)*<\/style>/gi, '')
    .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '')
    .replace(/<object\b[^<]*(?:(?!<\/object>)<[^<]*)*<\/object>/gi, '')
    .replace(/<embed\b[^>]*>/gi, '')
    .replace(/<applet\b[^<]*(?:(?!<\/applet>)<[^<]*)*<\/applet>/gi, '')
    .replace(/<form\b[^<]*(?:(?!<\/form>)<[^<]*)*<\/form>/gi, '');

  // Strip all on* attributes (onclick, onerror, onload, etc.)
  clean = clean.replace(/\s+on[a-z]+\s*=\s*("[^"]*"|'[^']*'|[^\s>]+)/gi, '');

  // Disarm dangerous URI schemes (javascript:, vbscript:, data:)
  clean = clean.replace(/(href|src)\s*=\s*(["'])\s*(javascript|data|vbscript):/gi, '$1=$2#safe-fallback:');

  return clean;
}

function extractYouTubeId(url: string): string | null {
  if (!url) return null;
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([a-zA-Z0-9_-]{11})/);
  return match ? match[1] : null;
}

if (typeof value === 'string') {
  html = sanitizeHtmlContent(value);
} else if (value && Array.isArray(value)) {
  try {
    html = toHTML(value, {
      components: {
        block: {
          normal: ({ children }) => {
            const trimmed = String(children || '').trim();
            if (!trimmed) return '';
            return `<p class="text-base sm:text-lg text-slate-700 leading-relaxed font-medium mb-5">${children}</p>`;
          },
          h1: ({ children }) => `<h1 class="text-3xl sm:text-4xl font-black font-heading text-slate-900 mt-10 mb-5 leading-tight">${children}</h1>`,
          h2: ({ children }) => `<h2 class="text-2xl sm:text-3xl font-black font-heading text-slate-900 mt-9 mb-4 leading-snug">${children}</h2>`,
          h3: ({ children }) => `<h3 class="text-xl sm:text-2xl font-black font-heading text-slate-900 mt-7 mb-3 leading-snug">${children}</h3>`,
          h4: ({ children }) => `<h4 class="text-lg sm:text-xl font-black font-heading text-slate-900 mt-6 mb-2 leading-snug">${children}</h4>`,
          blockquote: ({ children }) => `<blockquote class="border-l-4 border-[#FDB913] pl-5 py-3.5 my-7 bg-[#FFFDF5] rounded-r-2xl border border-amber-200/50 italic text-slate-800 text-base sm:text-lg font-medium leading-relaxed">${children}</blockquote>`,
        },
        list: {
          bullet: ({ children }) => `<ul class="list-disc pl-6 space-y-2.5 text-slate-700 font-medium my-6">${children}</ul>`,
          number: ({ children }) => `<ol class="list-decimal pl-6 space-y-2.5 text-slate-700 font-medium my-6">${children}</ol>`,
        },
        listItem: {
          bullet: ({ children }) => `<li class="leading-relaxed pl-1 text-slate-700 font-medium">${children}</li>`,
          number: ({ children }) => `<li class="leading-relaxed pl-1 text-slate-700 font-medium">${children}</li>`,
        },
        marks: {
          strong: ({ children }) => `<strong class="font-black text-slate-900">${children}</strong>`,
          em: ({ children }) => `<em>${children}</em>`,
          underline: ({ children }) => `<u>${children}</u>`,
          code: ({ children }) => `<code class="bg-slate-100 text-slate-900 px-1.5 py-0.5 rounded text-sm font-mono">${children}</code>`,
          link: ({ children, value }) => {
            const rawHref = String(value?.href || '').trim();
            // Security: Strictly enforce safe URI schemes to prevent javascript: or data: XSS attacks
            const isSafeScheme = /^(https?:|\/|mailto:|tel:|#)/i.test(rawHref);
            const safeHref = isSafeScheme ? rawHref.replace(/"/g, '&quot;') : '#';
            const isExternal = /^https?:\/\//i.test(safeHref);
            const rel = isExternal ? 'noreferrer noopener' : undefined;
            const target = (value?.blank || isExternal) ? '_blank' : undefined;
            return `<a href="${safeHref}" ${rel ? `rel="${rel}"` : ''} ${target ? `target="${target}"` : ''} class="text-[#30B2E7] hover:underline font-bold transition-colors">${children}</a>`;
          },
        },
        types: {
          image: ({ value }) => {
            const url = value?.url || value?.asset?.url || getImageUrl(value) || '';
            if (!url) return '';
            const safeAlt = escapeHtml(String(value.alt || 'QShala Content Image'));
            const safeCaption = value.caption ? `<figcaption class="text-xs text-slate-500 mt-2 text-center font-medium">${escapeHtml(String(value.caption))}</figcaption>` : '';
            return `<figure class="my-8 rounded-2xl overflow-hidden shadow-sm border border-slate-100"><img src="${url}" alt="${safeAlt}" class="w-full h-auto object-cover" loading="lazy" />${safeCaption}</figure>`;
          },
          videoEmbed: ({ value }) => {
            const rawUrl = String(value?.url || '').trim();
            if (!rawUrl) return '';
            const safeUrl = rawUrl.replace(/"/g, '&quot;');
            const safeCaption = value.caption ? escapeHtml(String(value.caption)) : '';
            const ytId = extractYouTubeId(rawUrl);

            if (ytId) {
              return `
                <div class="my-8 rounded-3xl overflow-hidden shadow-md border border-slate-200 bg-slate-950">
                  <div class="relative w-full aspect-[16/9]">
                    <iframe
                      src="https://www.youtube-nocookie.com/embed/${ytId}"
                      title="${safeCaption || 'QShala Outreach Video'}"
                      class="w-full h-full border-0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                    ></iframe>
                  </div>
                  <div class="p-3.5 bg-slate-900 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 text-xs">
                    <span class="text-slate-300 font-semibold truncate">${safeCaption || 'QShala Event Outreach Video'}</span>
                    <a href="${safeUrl}" target="_blank" rel="noopener noreferrer" class="shrink-0 inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-[#FF0000] hover:bg-red-600 text-white font-black uppercase text-[11px] font-heading shadow-xs transition-all">
                      <span>Watch on YouTube</span>
                      <span>&rarr;</span>
                    </a>
                  </div>
                </div>
              `;
            }

            // Instagram / Alternate Video link
            const isInstagram = rawUrl.includes('instagram.com') || rawUrl.includes('instagr.am');
            return `
              <div class="my-8 rounded-3xl overflow-hidden shadow-sm border border-slate-200 bg-gradient-to-br from-[#FFFDF5] to-[#FFF8E1] p-5 sm:p-7">
                <div class="flex items-center gap-3.5 mb-3">
                  <div class="w-11 h-11 rounded-2xl ${isInstagram ? 'bg-gradient-to-tr from-[#833AB4] via-[#FD1D1D] to-[#F77737]' : 'bg-[#30B2E7]'} flex items-center justify-center text-white shadow-xs shrink-0">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  </div>
                  <div>
                    <span class="text-[11px] font-black uppercase text-slate-500 font-heading tracking-wider">${isInstagram ? 'Instagram Outreach Video' : 'Featured Video'}</span>
                    <h4 class="text-base sm:text-lg font-black text-slate-900 font-heading leading-tight">${safeCaption || 'Watch Outreach Video Clip'}</h4>
                  </div>
                </div>
                <div class="pt-2">
                  <a href="${safeUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full ${isInstagram ? 'bg-gradient-to-r from-[#833AB4] via-[#FD1D1D] to-[#F77737] hover:opacity-95' : 'bg-[#30B2E7] hover:bg-sky-500'} text-white text-xs font-black uppercase tracking-wider font-heading shadow-xs hover:shadow-md hover:-translate-y-0.5 transition-all min-h-[42px]">
                    <span>${isInstagram ? 'Watch on Instagram' : 'Watch Video'}</span>
                    <span>&rarr;</span>
                  </a>
                </div>
              </div>
            `;
          },
          postButton: ({ value }) => {
            const rawLabel = String(value?.label || 'Learn More').trim();
            const rawUrl = String(value?.url || '#').trim();
            if (!rawUrl) return '';
            const safeLabel = escapeHtml(rawLabel);
            const safeUrl = rawUrl.replace(/"/g, '&quot;');
            const isExternal = /^https?:\/\//i.test(rawUrl);
            const openInNewTab = Boolean(value?.openInNewTab || isExternal);
            const targetAttr = openInNewTab ? 'target="_blank" rel="noopener noreferrer"' : '';

            let colorClasses = 'bg-[#FDB913] hover:bg-amber-400 text-slate-950';
            if (value?.style === 'blue') {
              colorClasses = 'bg-[#30B2E7] hover:bg-sky-500 text-white';
            } else if (value?.style === 'green') {
              colorClasses = 'bg-[#75B543] hover:bg-emerald-600 text-white';
            } else if (value?.style === 'dark') {
              colorClasses = 'bg-slate-900 hover:bg-black text-white';
            }

            return `
              <div class="my-7 flex items-center justify-start">
                <a href="${safeUrl}" ${targetAttr} class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full ${colorClasses} font-black text-xs sm:text-sm uppercase tracking-wider font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all min-h-[44px]">
                  <span>${safeLabel}</span>
                  <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
                </a>
              </div>
            `;
          },
        },
      },
    });
  } catch (err) {
    console.warn('[PortableText] Render error:', err);
    html = '';
  }
}
---

<div class={`prose max-w-none ${className}`} set:html={html} />
