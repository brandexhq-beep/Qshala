---
import { toHTML } from '@portabletext/to-html';
import { getImageUrl } from '../lib/sanity/image';

interface Props {
  value: any;
  class?: string;
}

const { value, class: className = '' } = Astro.props;

let html = '';

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

/**
 * Sanitizes raw HTML strings according to modern-web-guidance
 * Strips XSS vectors (scripts, inline events, unsafe schemes) while preserving
 * standard typography tags (p, h1-h6, ul, ol, li, blockquote, a, img, strong, em).
 */
function sanitizeHtmlContent(raw: string): string {
  if (!raw) return '';
  const trimmed = raw.trim();

  // If the input is plain text without any HTML tags, wrap cleanly in paragraphs
  if (!/<[a-z][\s\S]*>/i.test(trimmed)) {
    return trimmed
      .split(/\n\s*\n/)
      .map(p => `<p class="leading-relaxed mb-4">${escapeHtml(p.trim())}</p>`)
      .join('');
  }

  // Strip dangerous elements
  let clean = trimmed
    .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
    .replace(/<style\b[^<]*(?:(?!<\/style>)<[^<]*)*<\/style>/gi, '')
    .replace(/<iframe\b[^<]*(?:(?!<\/iframe>)<[^<]*)*<\/iframe>/gi, '')
    .replace(/<object\b[^<]*(?:(?!<\/object>)<[^<]*)*<\/object>/gi, '')
    .replace(/<embed\b[^>]*>/gi, '')
    .replace(/<applet\b[^<]*(?:(?!<\/applet>)<[^<]*)*<\/applet>/gi, '')
    .replace(/<form\b[^<]*(?:(?!<\/form>)<[^<]*)*<\/form>/gi, '');

  // Strip all on* attributes (onclick, onerror, onload, etc.)
  clean = clean.replace(/\s+on[a-z]+\s*=\s*("[^"]*"|'[^']*'|[^\s>]+)/gi, '');

  // Disarm dangerous URI schemes (javascript:, vbscript:, data:)
  clean = clean.replace(/(href|src)\s*=\s*(["'])\s*(javascript|data|vbscript):/gi, '$1=$2#safe-fallback:');

  return clean;
}

if (typeof value === 'string') {
  html = sanitizeHtmlContent(value);
} else if (value && Array.isArray(value)) {
  try {
    html = toHTML(value, {
      components: {
        types: {
          image: ({ value }) => {
            const url = getImageUrl(value);
            const safeAlt = escapeHtml(String(value.alt || 'QShala Content Image'));
            const safeCaption = value.caption ? `<figcaption class="text-xs text-slate-500 mt-2 text-center font-medium">${escapeHtml(String(value.caption))}</figcaption>` : '';
            return `<figure class="my-6 rounded-2xl overflow-hidden shadow-sm"><img src="${url}" alt="${safeAlt}" class="w-full h-auto object-cover" loading="lazy" />${safeCaption}</figure>`;
          },
        },
        marks: {
          link: ({ children, value }) => {
            const rawHref = String(value?.href || '').trim();
            // Security: Strictly enforce safe URI schemes to prevent javascript: or data: XSS attacks
            const isSafeScheme = /^(https?:|\/|mailto:|tel:|#)/i.test(rawHref);
            const safeHref = isSafeScheme ? rawHref.replace(/"/g, '&quot;') : '#';
            const isExternal = /^https?:\/\//i.test(safeHref);
            const rel = isExternal ? 'noreferrer noopener' : undefined;
            const target = (value?.blank || isExternal) ? '_blank' : undefined;
            return `<a href="${safeHref}" ${rel ? `rel="${rel}"` : ''} ${target ? `target="${target}"` : ''} class="text-[#30B2E7] hover:underline font-bold">${children}</a>`;
          },
        },
      },
    });
  } catch (err) {
    console.warn('[PortableText] Render error:', err);
    html = '';
  }
}
---

<div class={`prose max-w-none ${className}`} set:html={html} />
