---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';
import BlogShowcase, { type BlogPost } from '../components/BlogShowcase';
import NewsletterSubscription from '../components/NewsletterSubscription';
import { getPosts, getAllCaseStudies, getSiteSettings } from '../lib/sanity/api';
import { getImageUrl } from '../lib/sanity/image';

const [cmsPosts, caseStudies, siteSettings] = await Promise.all([
  getPosts(),
  getAllCaseStudies(),
  getSiteSettings(),
]);

const DEFAULT_POST_IMAGE = '/assets/media/banners/nlq_final.webp';

function resolvePostImage(p: any): string {
  if (p.image) {
    const url = getImageUrl(p.image, 800, 500);
    if (url) return url;
  }
  if (p.imageUrl) return p.imageUrl;
  if (p.mainImage) {
    const url = getImageUrl(p.mainImage, 800, 500);
    if (url) return url;
  }
  if (p.mainImageUrl) return p.mainImageUrl;
  const firstGallery = p.gallery?.[0];
  if (firstGallery) {
    if (firstGallery.image) {
      const url = getImageUrl(firstGallery.image, 800, 500);
      if (url) return url;
    }
    if (firstGallery.asset) {
      const url = getImageUrl(firstGallery, 800, 500);
      if (url) return url;
    }
    if (firstGallery.url) return firstGallery.url;
  }
  return DEFAULT_POST_IMAGE;
}

// Convert case studies with showInBlogFeed enabled into Blog/Events feed items
const blogCaseStudies: BlogPost[] = caseStudies
  .filter((cs: any) => cs.showInBlogFeed !== false)
  .map((cs: any) => ({
    slug: typeof cs.slug === 'string' ? cs.slug : cs.slug?.current || '',
    title: cs.title,
    category: 'Events' as const,
    readTime: cs.clientName ? `${cs.clientName}` : 'Event Story',
    summary: cs.summary || '',
    image: resolvePostImage(cs),
  }));

const formattedStandardPosts: BlogPost[] = cmsPosts.map((p: any) => ({
  slug: typeof p.slug === 'string' ? p.slug : p.slug?.current || '',
  title: p.title,
  category: (p.category === 'Events' ? 'Events' : 'Blog') as any,
  readTime: p.readTime || '5 min read',
  summary: p.summary || '',
  image: resolvePostImage(p),
}));

// Case studies come first or merged cleanly
const formattedPosts: BlogPost[] = [...blogCaseStudies, ...formattedStandardPosts];

const blogSchema = {
  "@type": "CollectionPage",
  "@id": "https://qshala.com/blog#collection",
  "name": "QShala Blog",
  "description": "Read insights on socratic education, school quiz clubs, quizmastering in India, corporate trivia, and view photo event reports from across India.",
  "publisher": {
    "@id": "https://qshala.com/#organization"
  }
};
---

<BaseLayout 
  title="Blog | QShala India — Questions, Quriosity, Quests"
  description="Explore perspectives on socratic learning, child curiosity, corporate trivia, and live photo event reports from India's premier quizmasters."
  pageType="CollectionPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Blog", item: "/blog" }
  ]}
  schema={blogSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-header-safe pb-24 px-4 sm:px-8 md:px-12 w-full max-w-[1536px] mx-auto space-y-16 bg-[#FFFDF5]">
    
    <!-- Page Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 pt-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm">
        {siteSettings.blogBannerLabel || "Quriosity Literature"}
      </span>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 font-heading leading-tight">
          {siteSettings.blogHeading || "Learning Out Loud."}
        </h1>
        <div class="shrink-0 hidden sm:block">
          <QTMascot client:visible variant="reading" size="md" />
        </div>
      </div>
      
      <p class="text-slate-600 font-semibold text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        {siteSettings.blogSubheading || "Stories, ideas and photos from the quizzes, classrooms and events we love running."}
      </p>
    </div>

    <!-- Interactive Blog & Event Reports Showcase -->
    <div class="w-full relative clear-both">
      <BlogShowcase client:load initialPosts={formattedPosts} />
    </div>

    <!-- Newsletter Digest Card -->
    <section class="pt-10 pb-6 w-full relative clear-both">
      <div class="bg-[#F2FCE8] rounded-3xl p-8 md:p-12 border border-[#75B543]/25 shadow-sm text-center max-w-3xl mx-auto space-y-6 relative overflow-hidden">
        <div class="space-y-2">
          <span class="inline-block px-3.5 py-1 rounded-full bg-[#75B543] text-white font-black text-xs uppercase font-heading shadow-xs">
            QQL Club
          </span>
          <h2 class="text-2xl sm:text-3xl font-black font-heading text-slate-900 pt-1">
            Subscribe to QQL Club
          </h2>
          <p class="text-slate-700 font-semibold max-w-xl mx-auto text-sm sm:text-base leading-relaxed">
            Five questions in your inbox every day, and a Monthly Mega Quiz every month. ₹499 for six months.
          </p>
        </div>
        
        <div class="max-w-md mx-auto">
          <NewsletterSubscription 
            client:visible 
            variant="qql" 
            isDirectLink={true} 
            buttonLabel="Subscribe" 
            paymentUrl={siteSettings.qqlPaymentUrl} 
          />
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
