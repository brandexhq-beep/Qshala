---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getAllCaseStudies } from '../lib/sanity/api';
import { getImageUrl } from '../lib/sanity/image';

const caseStudies = await getAllCaseStudies();

const CASE_STUDY_IMAGES: Record<string, string> = {
  'dps-bangalore-quriosity-league': '/assets/media/schools/qe1.webp',
  'flipkart-corporate-trivia-league': '/assets/media/corporate/qe3.webp',
  'wipro-onboarding-gamification': '/assets/media/corporate/corp_hertie.webp',
  'nps-socratic-science-storytelling': '/assets/media/schools/2.webp',
  'inventure-academy-critical-thinking': '/assets/media/schools/3.webp',
  'tcs-cross-hub-workplace-engagement': '/assets/media/corporate/photo-2026-10-09-16-30-40.webp',
  'iit-bombay-techfest-championship': '/assets/media/colleges/c1.webp',
  'iim-bangalore-business-simulations': '/assets/media/colleges/c2.webp',
  'sobha-city-family-game-nights': '/assets/media/crowd/dsc07829.webp',
  'wework-community-networking-nights': '/assets/media/corporate/qe5.webp',
};

const CATEGORY_COLORS: Record<string, string> = {
  School: '#75B543',
  Corporate: '#FDB913',
  College: '#30B2E7',
  Community: '#9333EA',
};

const caseStudiesSchema = {
  "@type": "ItemList",
  "@id": "https://qshala.vercel.app/case-studies#list",
  "name": "QShala Learning Impact & Partner Case Studies",
  "itemListElement": caseStudies.map((study, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "CreativeWork",
      "name": study.title,
      "headline": study.title,
      "abstract": study.summary,
      "author": {
        "@id": "https://qshala.vercel.app/#organization"
      }
    }
  }))
};
---

<BaseLayout 
  title="Case Studies & Learning Impact | QShala India"
  description="Real-world case studies detailing how 10+ schools, corporates, and universities partnered with QShala to foster curiosity and critical thinking."
  pageType="CollectionPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Case Studies", item: "/case-studies" }
  ]}
  schema={caseStudiesSchema}
>
  <Navbar />
  
  <main id="main-content" class="flex-grow pt-header-safe pb-24 px-4 sm:px-8 md:px-12 w-full max-w-[1536px] mx-auto space-y-16 bg-[#FFFDF5]">
    
    <!-- Page Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 pt-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm">
        Real Impact Stories
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight">
        QShala Case Studies.
      </h1>
      <p class="text-slate-600 font-semibold text-base sm:text-lg max-w-xl mx-auto leading-relaxed">
        Explore how leading schools, corporate workplaces, universities, and communities use QShala to ignite curiosity and active learning.
      </p>
    </div>

    <!-- Category Filter Bar -->
    <div class="flex items-center justify-start sm:justify-center gap-2 overflow-x-auto scrollbar-none pb-2 px-1" id="csFilterBar">
      <button
        type="button"
        data-filter="all"
        class="cs-filter-btn px-4 py-2 rounded-full font-black text-xs font-heading transition-all whitespace-nowrap cursor-pointer min-h-[38px] bg-slate-900 text-white shadow-xs"
      >
        All Stories (10)
      </button>
      <button
        type="button"
        data-filter="School"
        class="cs-filter-btn px-4 py-2 rounded-full font-black text-xs font-heading transition-all whitespace-nowrap cursor-pointer min-h-[38px] bg-white text-slate-700 hover:bg-slate-100 border border-slate-200"
      >
        Schools
      </button>
      <button
        type="button"
        data-filter="Corporate"
        class="cs-filter-btn px-4 py-2 rounded-full font-black text-xs font-heading transition-all whitespace-nowrap cursor-pointer min-h-[38px] bg-white text-slate-700 hover:bg-slate-100 border border-slate-200"
      >
        Corporates
      </button>
      <button
        type="button"
        data-filter="College"
        class="cs-filter-btn px-4 py-2 rounded-full font-black text-xs font-heading transition-all whitespace-nowrap cursor-pointer min-h-[38px] bg-white text-slate-700 hover:bg-slate-100 border border-slate-200"
      >
        Colleges
      </button>
      <button
        type="button"
        data-filter="Community"
        class="cs-filter-btn px-4 py-2 rounded-full font-black text-xs font-heading transition-all whitespace-nowrap cursor-pointer min-h-[38px] bg-white text-slate-700 hover:bg-slate-100 border border-slate-200"
      >
        Community
      </button>
    </div>

    <!-- Blog-style 2-Column Wide Image Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full">
      {caseStudies.map((cs) => {
        const slug = typeof cs.slug === 'string' ? cs.slug : cs.slug?.current || '';
        const image = (cs.coverImage ? getImageUrl(cs.coverImage, 800, 600) : null) || CASE_STUDY_IMAGES[slug] || 'https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=800&auto=format&fit=crop';
        const tagColor = CATEGORY_COLORS[cs.clientType] || '#30B2E7';

        return (
          <a 
            href={`/blog/${slug}`}
            data-category={cs.clientType} 
            class="bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all flex flex-col justify-between group cursor-pointer block"
            aria-label={`Read event story and view photos for ${cs.title}`}
          >
            
            {/* Top Image Banner */}
            <div class="relative aspect-[16/10] sm:aspect-[16/9] w-full overflow-hidden bg-slate-100">
              <img 
                src={image} 
                alt={cs.clientName} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy"
              />
              <div class="absolute top-4 left-4">
                <span 
                  class="px-3.5 py-1 rounded-full text-white text-xs font-black uppercase font-heading shadow-sm"
                  style={`background-color: ${tagColor};`}
                >
                  {cs.clientType} • {cs.clientName}
                </span>
              </div>
            </div>

            {/* Card Content */}
            <div class="p-5 sm:p-8 space-y-4 flex-grow flex flex-col justify-between">
              <div class="space-y-3">
                <h2 class="text-xl sm:text-2xl font-black text-slate-900 font-heading leading-snug group-hover:text-[#30B2E7] transition-colors">
                  {cs.title}
                </h2>

                {/* Single Clean Text Box */}
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 text-slate-700 text-sm font-semibold leading-relaxed">
                  {cs.summary}
                </div>
              </div>

              {/* Quote & Clickable Action */}
              <div class="pt-4 border-t border-slate-100 space-y-3">
                <blockquote class="italic text-xs text-slate-600 font-medium">
                  &ldquo;{cs.quote.text}&rdquo; — <span class="font-bold text-slate-900 not-italic">{cs.quote.author} ({cs.quote.role})</span>
                </blockquote>

                <div class="flex items-center justify-between font-heading font-black text-xs text-slate-900 group-hover:text-[#30B2E7] transition-colors pt-3 border-t border-slate-100">
                  <span>Read Event Story &amp; View Photos</span>
                  <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </div>
              </div>

            </div>

          </a>
        );
      })}
    </div>

    <!-- Bottom Consultation Banner -->
    <div class="bg-[#FFF8E1] rounded-3xl p-5 sm:p-8 md:p-12 border border-amber-200/80 shadow-sm text-center max-w-3xl mx-auto space-y-4">
      <h2 class="text-3xl font-black text-slate-900 font-heading">
        Ready to Create Your Own Impact Story?
      </h2>
      <p class="text-slate-700 font-semibold text-sm sm:text-base">
        Partner with QShala to design custom learning tracks or live quiz championships for your institution.
      </p>
      <div class="pt-2 flex flex-wrap justify-center gap-4">
        <a 
          href="/contact"
          class="w-full sm:w-auto text-center justify-center inline-flex items-center px-6 sm:px-8 py-3.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-sm hover:shadow-md transition-all min-h-[44px]"
        >
          Speak with Our Team &rarr;
        </a>
      </div>
    </div>

  </main>
  
  <Footer />
</BaseLayout>

<script>
  function setupCaseStudiesFilter() {
    const buttons = document.querySelectorAll('.cs-filter-btn');
    const cards = document.querySelectorAll('[data-category]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        buttons.forEach((b) => {
          if (b === btn) {
            b.className = "cs-filter-btn px-4 py-2 rounded-full font-black text-xs font-heading transition-all whitespace-nowrap cursor-pointer min-h-[38px] bg-slate-900 text-white shadow-xs";
          } else {
            b.className = "cs-filter-btn px-4 py-2 rounded-full font-black text-xs font-heading transition-all whitespace-nowrap cursor-pointer min-h-[38px] bg-white text-slate-700 hover:bg-slate-100 border border-slate-200";
          }
        });

        cards.forEach((card) => {
          const el = card as HTMLElement;
          const cat = el.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            el.style.display = '';
          } else {
            el.style.display = 'none';
          }
        });
      });
    });
  }

  setupCaseStudiesFilter();
  document.addEventListener('astro:page-load', setupCaseStudiesFilter);
</script>
