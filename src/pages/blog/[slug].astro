  function formatCmsPost(cp: any, slugStr: string) {
    const formattedDate = cp.publishedAt 
      ? new Date(cp.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) 
      : 'Recent';

    const gallery = (cp.gallery || []).map((g: any) => ({
      url: g.url || (g.asset ? getImageUrl(g, 1200, 800) : ''),
      caption: g.caption || ''
    }));

    return {
      slug: slugStr,
      title: cp.title,
      category: cp.category || 'Blog',
      readTime: cp.readTime || '5 min read',
      date: formattedDate,
      isoDate: cp.publishedAt || '2026-10-14T10:00:00+05:30',
      author: cp.author || 'Sachin Ravi',
      authorRole: 'QShala Team',
      summary: cp.summary || '',
      color: '#30B2E7',
      bg: 'bg-[#E8F6FD]',
      body: cp.body || null,
      content: typeof cp.content === 'string' ? cp.content : `<p>${cp.summary || ''}</p>`,
      gallery
    };
  }

  const cmsMap = new Map<string, any>();
  cmsPosts.forEach(cp => {
    const slugStr = typeof cp.slug === 'string' ? cp.slug : cp.slug?.current;
    if (slugStr) {
      cmsMap.set(slugStr, formatCmsPost(cp, slugStr));
    }
  });

  const mergedPosts = [...posts.filter(p => !cmsMap.has(p.slug)), ...Array.from(cmsMap.values())];

  return mergedPosts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

const articleSchema = {
  "@type": "BlogPosting",
  "@id": `https://qshala.vercel.app/blog/${post.slug}#article`,
  "headline": post.title,
  "description": post.summary,
  "articleSection": post.category,
  "inLanguage": "en-IN",
  "url": `https://qshala.vercel.app/blog/${post.slug}`,
  "datePublished": post.isoDate,
  "dateModified": "2026-10-14T18:00:00+05:30",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://qshala.vercel.app/blog/${post.slug}`
  },
  "author": {
    "@type": "Person",
    "name": post.author,
    "jobTitle": post.authorRole,
    "worksFor": {
      "@id": "https://qshala.vercel.app/#organization"
    }
  },
  "publisher": {
    "@id": "https://qshala.vercel.app/#organization"
  },
  "isPartOf": {
    "@id": "https://qshala.vercel.app/#website"
  },
  "image": post.gallery && post.gallery[0] ? post.gallery[0].url : "https://qshala.vercel.app/og-image.webp"
};
