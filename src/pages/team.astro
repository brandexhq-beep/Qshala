---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import InteractiveTeamShowcase from '../components/InteractiveTeamShowcase';
import { getCuriosityCrew } from '../lib/sanity/api';
import { getImageUrl } from '../lib/sanity/image';

const crew = await getCuriosityCrew();

const CREW_THEMES: Record<string, { color: string; bg: string }> = {
  Technology: { color: '#30B2E7', bg: '#E8F6FD' },
  Curriculum: { color: '#75B543', bg: '#EDF7E5' },
  Partnerships: { color: '#EC4899', bg: '#FCE7F3' },
  Corporate: { color: '#75B543', bg: '#EDF7E5' },
  Design: { color: '#FDB913', bg: '#FFF8E1' },
};

const formattedCrew = crew.map(c => {
  const cat = c.category || 'General';
  const theme = CREW_THEMES[cat] || { color: '#FDB913', bg: '#FFF8E1' };
  const fallbackAvatar = `https://ui-avatars.com/api/?name=${encodeURIComponent(c.name)}&background=75B543&color=fff&size=300`;

  return {
    id: c._id || c.name.toLowerCase().replace(/[^a-z0-9]/g, '-'),
    name: c.name,
    role: c.role,
    category: cat,
    bio: c.bio || '',
    image: c.imageUrl || (c.image ? getImageUrl(c.image, 300, 300) : fallbackAvatar),
    variant: (c.mascotVariant || 'curious') as any,
    color: theme.color,
    bg: theme.bg,
    tag: cat
  };
});

const teamSchema = {
  "@type": "AboutPage",
  "@id": "https://qshala.vercel.app/team#page",
  "name": "Meet the Curiosity Crew & Quizmasters | QShala",
  "description": "Meet the educators, quizmasters, researchers, and experience designers at QShala making learning an active discovery adventure.",
  "mainEntity": {
    "@id": "https://qshala.vercel.app/#organization"
  }
};
---

<BaseLayout 
  title="Meet the Team | Quriosity Crew & Quizmasters | QShala"
  description="Meet the educators, quizmasters, researchers, and experience designers at QShala making learning an unforgettable adventure."
  pageType="AboutPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Team", item: "/team" }
  ]}
  schema={teamSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-header-safe pb-24 bg-[#FFFDF5] w-full">
    <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 py-4">
      <InteractiveTeamShowcase client:load members={formattedCrew} />
    </div>
  </main>

  <Footer />
</BaseLayout>
