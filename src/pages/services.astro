---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';
import { getAllServicePages } from '../lib/sanity/api';

const cmsServices = await getAllServicePages();

const DEFAULT_SERVICE_MODULES = [
  {
    id: "schools",
    href: "/schools",
    title: "Quriosity in Your School",
    badge: "Schools",
    description: "Year-round programs, competitions and teacher training that make learning something students look forward to.",
    mascotVariant: "reading" as const,
    imageSrc: "/assets/media/schools/untitled_design.webp",
    imageAlt: "School students learning curiously in classroom",
    ctaText: "Explore School Programs",
    color: "#30B2E7",
    bgTint: "#E8F6FD"
  },
  {
    id: "companies",
    href: "/companies",
    title: "Quriosity at Work",
    badge: "Companies",
    description: "Quizzes, games and team activities that get people talking, for offsites, onboarding and everything in between.",
    mascotVariant: "professional" as const,
    imageSrc: "/assets/media/corporate/photo-2026-10-09-16-30-24.webp",
    imageAlt: "Corporate team collaborating during live event",
    ctaText: "Explore Corporate Solutions",
    color: "#75B543",
    bgTint: "#EDF7E5"
  },
  {
    id: "colleges",
    href: "/colleges",
    title: "Quriosity on Campus",
    badge: "Colleges",
    description: "From a fest quiz to a nationwide league, on any subject you can think of.",
    mascotVariant: "idea" as const,
    imageSrc: "/assets/media/colleges/c1.webp",
    imageAlt: "College students celebrating graduation and campus fest",
    ctaText: "Explore College Programs",
    color: "#FDB913",
    bgTint: "#FFF8E1"
  },
  {
    id: "communities",
    href: "/communities",
    title: "Quriosity for Your Crowd",
    badge: "Communities & Families",
    description: "Your housing society, your family, your birthday or wedding guests. Wherever people gather, there's a quiz waiting.",
    mascotVariant: "curious" as const,
    imageSrc: "/assets/media/crowd/whatsapp_image_2026-06-08_at_6_13_58_pm_1.webp",
    imageAlt: "Friends gathering happily at a community event",
    ctaText: "Explore Community Programs",
    color: "#30B2E7",
    bgTint: "#E8F6FD"
  },
  {
    id: "custom",
    href: "/custom",
    title: "Have an Idea?",
    badge: "Custom",
    description: "Got an event we haven't thought of yet? Tell us and let's build it together!",
    mascotVariant: "trophy" as const,
    imageSrc: "/assets/media/banners/booklaunch2.webp",
    imageAlt: "Team designing custom learning experience",
    ctaText: "Tell Us Your Idea",
    color: "#FDB913",
    bgTint: "#FFF8E1"
  }
];

const SERVICE_MODULES = DEFAULT_SERVICE_MODULES.map((def) => {
  const match = cmsServices.find((s) => s.slug === def.id || (typeof s.slug === 'object' && (s.slug as any).current === def.id));
  if (!match) return def;
  return {
    ...def,
    title: match.title || def.title,
    badge: match.badge || def.badge,
    description: match.intro || def.description,
    mascotVariant: (match.mascotVariant || def.mascotVariant) as any,
  };
});

const servicesSchema = {
  "@type": "ItemList",
  "@id": "https://qshala.vercel.app/services#list",
  "name": "QShala Services & Learning Modules",
  "itemListElement": SERVICE_MODULES.map((service, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Service",
      "name": service.title,
      "description": service.description,
      "serviceType": service.badge,
      "provider": {
        "@id": "https://qshala.vercel.app/#organization"
      }
    }
  }))
};
---

<BaseLayout 
  title="Quriosity Services & Programs | QShala India"
  description="Consultative learning and quiz programs for K-12 schools, corporate teams, college fests, communities, and custom experiences."
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Services", item: "/services" }
  ]}
  schema={servicesSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-header-safe pb-24 bg-[#FFFDF5] w-full">

    <!-- Page Header -->
    <section class="py-8 w-full px-4 sm:px-8 md:px-12">
      <div class="max-w-4xl mx-auto text-center space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-slate-200 shadow-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-[#30B2E7] animate-ping"></span>
          <span class="text-xs font-black uppercase text-slate-800 tracking-wider font-heading">
            Our Learning Programs
          </span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading">
          Quriosity for Every Audience.
        </h1>

        <p class="text-slate-600 font-semibold text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
          Quizzes are what we're best known for, but we also run games, workshops and team activities. Start here, explore as you go!
        </p>
      </div>
    </section>

    <!-- Services Modules Stack - Expansive max-w-[1536px] Width -->
    <section class="py-4 w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 space-y-8">
      {SERVICE_MODULES.map((module, idx) => {
        const isReversed = idx % 2 !== 0;
        return (
          <div 
            id={module.id}
            class="group p-6 sm:p-8 rounded-3xl transition-all duration-300 border border-slate-200/80 hover:border-slate-300 shadow-sm hover:shadow-md grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-white"
          >
            <!-- Image Thumbnail -->
            <div class={`lg:col-span-5 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
              <div class="relative">
                <div class="overflow-hidden rounded-2xl aspect-[16/10] bg-slate-100 shadow-sm">
                  <img 
                    src={module.imageSrc} 
                    alt={module.imageAlt} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>

                <div class="absolute -top-3 -right-3 bg-white p-2 rounded-2xl shadow-sm border border-slate-100 group-hover:scale-110 group-hover:-rotate-6 transition-all duration-300">
                  <QTMascot client:visible variant={module.mascotVariant} size="sm" />
                </div>
              </div>
            </div>

            <!-- Content Column: Label, Title, One Brief Line, CTA Button -->
            <div class={`lg:col-span-7 space-y-4 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
              <div class="space-y-2">
                <span 
                  class="inline-block px-3.5 py-1 rounded-full text-white font-black text-xs uppercase font-heading shadow-sm"
                  style={`background-color: ${module.color};`}
                >
                  {module.badge}
                </span>

                <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 font-heading tracking-tight">
                  {module.title}
                </h2>

                <p class="text-slate-700 text-sm sm:text-base font-semibold leading-relaxed">
                  {module.description}
                </p>
              </div>

              <!-- Action CTA -->
              <div class="pt-2">
                <a
                  href={module.href}
                  class="w-full sm:w-auto text-center justify-center min-h-[44px] px-7 py-3 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs sm:text-sm uppercase tracking-wider shadow-sm hover:shadow-md hover:-translate-y-0.5 font-heading transition-all inline-flex items-center gap-2 group/btn active:scale-95"
                >
                  <span>{module.ctaText}</span>
                  <span class="group-hover/btn:translate-x-1 transition-transform">&rarr;</span>
                </a>
              </div>

            </div>
          </div>
        );
      })}
    </section>

  </main>

  <Footer />
</BaseLayout>
