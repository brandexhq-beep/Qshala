---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProductDetailShowcase from '../../components/ProductDetailShowcase';
import { getShopifyProducts, type ShopifyProductItem } from '../../lib/shopify/client';

export async function getStaticPaths() {
  const products = await getShopifyProducts();
  return products.map((product) => ({
    params: { handle: product.handle },
    props: { product },
  }));
}

interface Props {
  product: ShopifyProductItem;
}

const { product } = Astro.props;

const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.title,
  "image": product.images.map((img) => img.url),
  "description": product.description,
  "brand": {
    "@type": "Brand",
    "name": "QShala"
  },
  "offers": {
    "@type": "Offer",
    "url": `https://qshala.com/shop/${product.handle}`,
    "priceCurrency": "INR",
    "price": product.price,
    "availability": product.availableForSale ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "seller": {
      "@type": "Organization",
      "name": "QShala"
    }
  }
};
---

<BaseLayout
  title={`${product.title} | QShala Quriosity Store`}
  description={product.subtitle || product.description?.slice(0, 150) || "Explore books and thinking games from QShala."}
  pageType="ItemPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Store", item: "/shop" },
    { name: product.title, item: `/shop/${product.handle}` }
  ]}
  schema={productSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-[68px] sm:pt-[76px] pb-24 bg-[#FFFDF5] w-full">
    <!-- Back to Store Navigation Link -->
    <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 pt-3 pb-1">
      <a
        href="/shop"
        class="inline-flex items-center gap-2 text-xs font-black uppercase text-slate-600 hover:text-[#30B2E7] font-heading transition-colors"
      >
        <span>&larr;</span>
        <span>Back to All Products</span>
      </a>
    </div>

    <!-- Main Product Showcase Section -->
    <section class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 pt-2 pb-20">
      <ProductDetailShowcase client:load product={product} />
    </section>
  </main>

  <Footer />
</BaseLayout>
