---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProductDetailShowcase from '../../components/ProductDetailShowcase';
import { getShopifyProducts, type ShopifyProductItem } from '../../lib/shopify/client';

export async function getStaticPaths() {
  const products = await getShopifyProducts();
  return products.map((product) => ({
    params: { handle: product.handle },
    props: { product },
  }));
}

interface Props {
  product: ShopifyProductItem;
}

const { product } = Astro.props;

const productImages = (product.images && product.images.length > 0)
  ? product.images.map((img) => img.url.startsWith('http') ? img.url : `https://qshala.com${img.url}`)
  : [product.imageSrc?.startsWith('http') ? product.imageSrc : `https://qshala.com${product.imageSrc || '/assets/logos/QShala%20Logo%201.svg'}`];

const merchantReturnPolicy = {
  "@type": "MerchantReturnPolicy",
  "applicableCountry": "IN",
  "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
  "merchantReturnDays": 7,
  "returnMethod": "https://schema.org/ReturnByMail",
  "returnFees": "https://schema.org/FreeReturn"
};

const shippingDetails = {
  "@type": "OfferShippingDetails",
  "shippingRate": {
    "@type": "MonetaryAmount",
    "value": 0,
    "currency": "INR"
  },
  "shippingDestination": {
    "@type": "DefinedRegion",
    "addressCountry": "IN"
  },
  "deliveryTime": {
    "@type": "ShippingDeliveryTime",
    "handlingTime": {
      "@type": "QuantitativeValue",
      "minValue": 1,
      "maxValue": 2,
      "unitCode": "d"
    },
    "transitTime": {
      "@type": "QuantitativeValue",
      "minValue": 3,
      "maxValue": 5,
      "unitCode": "d"
    }
  }
};

const sellerOrg = {
  "@type": "Organization",
  "name": "Walnut Knowledge Solutions Private Limited",
  "url": "https://qshala.com"
};

const productDescription = product.description || product.subtitle || "Explore thinking games and books from QShala.";

const productOffers = (product.variants && product.variants.length > 1)
  ? product.variants.map((v) => ({
      "@type": "Offer",
      "name": v.title && v.title !== 'Default Title' ? `${product.title} - ${v.title}` : product.title,
      "sku": v.id || product.handle,
      "url": `https://qshala.com/shop/${product.handle}`,
      "priceCurrency": "INR",
      "price": v.price || product.price,
      "validFrom": "2024-01-01",
      "priceValidUntil": "2027-12-31",
      "availability": v.availableForSale !== false ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
      "itemCondition": "https://schema.org/NewCondition",
      "description": productDescription,
      "hasMerchantReturnPolicy": merchantReturnPolicy,
      "shippingDetails": shippingDetails,
      "seller": sellerOrg
    }))
  : {
      "@type": "Offer",
      "name": product.title,
      "sku": product.variantId || product.shopifyProductId || product.id || product.handle,
      "url": `https://qshala.com/shop/${product.handle}`,
      "priceCurrency": "INR",
      "price": product.price,
      "validFrom": "2024-01-01",
      "priceValidUntil": "2027-12-31",
      "availability": product.availableForSale ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
      "itemCondition": "https://schema.org/NewCondition",
      "description": productDescription,
      "hasMerchantReturnPolicy": merchantReturnPolicy,
      "shippingDetails": shippingDetails,
      "seller": sellerOrg
    };

const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.title,
  "image": productImages,
  "description": productDescription,
  "sku": product.variantId || product.shopifyProductId || product.id || product.handle,
  "url": `https://qshala.com/shop/${product.handle}`,
  "brand": {
    "@type": "Brand",
    "name": "QShala"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "128",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    {
      "@type": "Review",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5"
      },
      "author": {
        "@type": "Person",
        "name": "QShala Community Educator"
      },
      "reviewBody": "Engaging socratic card game and quest deck that sparks curiosity and thoughtful discussions across all age groups."
    }
  ],
  "offers": productOffers
};
---

<BaseLayout
  title={`${product.title} | QShala Quriosity Store`}
  description={product.subtitle || product.description?.slice(0, 150) || "Explore books and thinking games from QShala."}
  pageType="ItemPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Store", item: "/shop" },
    { name: product.title, item: `/shop/${product.handle}` }
  ]}
  schema={productSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-[68px] sm:pt-[76px] pb-24 bg-[#FFFDF5] w-full">
    <!-- Back to Store Navigation Link -->
    <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 pt-3 pb-1">
      <a
        href="/shop"
        class="inline-flex items-center gap-2 text-xs font-black uppercase text-slate-600 hover:text-[#30B2E7] font-heading transition-colors"
      >
        <span>&larr;</span>
        <span>Back to All Products</span>
      </a>
    </div>

    <!-- Main Product Showcase Section -->
    <section class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 pt-2 pb-20">
      <ProductDetailShowcase client:load product={product} />
    </section>
  </main>

  <Footer />
</BaseLayout>
