---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getFAQs } from '../lib/sanity/api';

const faqs = await getFAQs();

// Group by category dynamically preserving categories
const categoryMap = new Map<string, { question: string; answer: string }[]>();
faqs.forEach(faq => {
  const cat = faq.category || 'General';
  if (!categoryMap.has(cat)) {
    categoryMap.set(cat, []);
  }
  categoryMap.get(cat)!.push({
    question: faq.question,
    answer: faq.answer
  });
});

const groupedFaqs = Array.from(categoryMap.entries()).map(([category, items]) => ({
  category,
  items
}));

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://qshala.com/faq#page",
  "name": "QShala Frequently Asked Questions",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<BaseLayout 
  title="Frequently Asked Questions (FAQ) | QShala India"
  description="Find answers about QShala's school curiosity clubs, corporate trivia nights, collegiate quizzes, year-long programs, and booking details."
  pageType="WebPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "FAQ", item: "/faq" }
  ]}
  schema={faqSchema}
>
  <Navbar />
  
  <main id="main-content" class="flex-grow pt-header-safe pb-24 px-4 sm:px-8 md:px-12 w-full max-w-[1536px] mx-auto space-y-16 bg-[#FFFDF5]">
    
    <!-- Page Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 pt-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm">
        Help Center &amp; FAQs
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight">
        Frequently Asked Questions.
      </h1>
      <p class="text-slate-600 font-semibold text-base sm:text-lg leading-relaxed">
        Everything you need to know about QShala's methodology, school programs, corporate offsites, and custom quizzing experiences.
      </p>
    </div>

    <!-- Categorized FAQ Groups -->
    <div class="space-y-12">
      {groupedFaqs.map((group) => (
        <div class="space-y-6">
          <div class="border-b border-slate-200 pb-2">
            <h2 class="text-2xl font-black text-slate-900 font-heading">
              {group.category}
            </h2>
          </div>

          <div class="space-y-4">
            {group.items.map((item) => (
              <details class="bg-white rounded-3xl p-4 sm:p-6 border border-slate-200/80 shadow-xs group open:shadow-sm open:ring-1 open:ring-[#30B2E7]/30 transition-all">
                <summary class="font-black text-base sm:text-lg font-heading text-slate-900 cursor-pointer list-none flex items-center justify-between gap-4 select-none focus-visible:outline-2 focus-visible:outline-[#30B2E7] min-h-[44px]">
                  <span class="min-w-0 pr-2">{item.question}</span>
                  <span class="w-8 h-8 rounded-full bg-slate-100 group-open:bg-[#30B2E7] group-open:text-white flex items-center justify-center shrink-0 transition-all text-xs">
                    ▼
                  </span>
                </summary>
                <div class="pt-4 text-slate-700 text-sm sm:text-base font-semibold leading-relaxed border-t border-slate-100 mt-4">
                  {item.answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Direct Inquiry Card -->
    <div class="bg-[#FFF8E1] rounded-3xl p-5 sm:p-8 md:p-12 border border-amber-200/80 shadow-sm text-center space-y-6">
      <h2 class="text-3xl font-black text-slate-900 font-heading">
        Still Have a Question?
      </h2>
      <p class="text-slate-700 font-semibold text-sm sm:text-base max-w-xl mx-auto">
        Speak directly with our team or call Co-Founder Sachin Ravi. We are happy to help design the right experience for your team or school.
      </p>
      <div class="pt-2 flex flex-col sm:flex-row justify-center items-center gap-3 sm:gap-4">
        <a 
          href="/contact"
          class="w-full sm:w-auto text-center justify-center inline-flex items-center px-6 sm:px-8 py-3.5 rounded-full bg-[#30B2E7] hover:bg-sky-500 text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm hover:shadow-md transition-all min-h-[44px]"
        >
          Contact Our Team &rarr;
        </a>
        <a 
          href="tel:+918971676100"
          class="w-full sm:w-auto text-center justify-center inline-flex items-center px-6 sm:px-8 py-3.5 rounded-full bg-white hover:bg-slate-50 text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-sm border border-slate-200 transition-all min-h-[44px]"
        >
          📞 Call +91 89716 76100
        </a>
      </div>
    </div>

  </main>
  
  <Footer />
</BaseLayout>
