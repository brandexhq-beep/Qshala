---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTAnimatedPlayer from '../components/QTAnimatedPlayer';
import InteractiveTeamShowcase from '../components/InteractiveTeamShowcase';
import { 
  getAboutPage, 
  getCoFounders, 
  getAdvisors, 
  getCuriosityCrew 
} from '../lib/sanity/api';
import { getImageUrl } from '../lib/sanity/image';

const aboutData = await getAboutPage();
const coFounders = await getCoFounders();
const advisors = await getAdvisors();
const rawCrew = await getCuriosityCrew();
const crew = rawCrew.map(c => ({
  ...c,
  imageUrl: c.imageUrl || (c.image ? getImageUrl(c.image, 300, 300) : '/assets/team/gauri-kashyap.webp')
}));

const pageTitle = aboutData.seo?.metaTitle || "About Us — Our Story & Mission | QShala India";
const pageDesc = aboutData.seo?.metaDescription || "Learn about QShala's mission to replace rote learning with curiosity and wonder. Founded in 2014 by Sachin Ravi & Raghav Chakravarthy, backed by top leaders.";

const aboutSchema = {
  "@type": "AboutPage",
  "@id": "https://qshala.vercel.app/about#page",
  "name": "About QShala — Our Story, Founders & Mission",
  "description": pageDesc,
  "mainEntity": {
    "@id": "https://qshala.vercel.app/#organization"
  }
};
---

<BaseLayout 
  title={pageTitle}
  description={pageDesc}
  pageType="AboutPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "About Us", item: "/about" }
  ]}
  schema={aboutSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-header-safe pb-16 bg-[#FFFDF5]">

    <!-- 1. HERO: OPEN EDITORIAL MISSION -->
    <section class="pt-4 pb-8 md:pt-6 md:pb-10 relative overflow-hidden w-full px-4 sm:px-8 md:px-12">
      <!-- Ambient Glowing Orbs -->
      <div class="absolute top-4 left-1/4 w-72 h-72 bg-[#30B2E7]/15 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
      <div class="absolute top-20 right-1/4 w-72 h-72 bg-[#FDB913]/20 rounded-full blur-3xl pointer-events-none animate-pulse"></div>

      <div class="w-full relative z-10">
        <div class="text-center max-w-4xl mx-auto space-y-4">
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white border border-slate-200 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-[#FDB913] animate-ping"></span>
            <span class="text-xs font-black uppercase tracking-wider font-heading text-slate-800">
              {aboutData.heroBadge || "Our Story"}
            </span>
          </div>

          <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight">
            {aboutData.heroHeading || "It Started With a Love of Questions."}
          </h1>

          <p class="text-slate-700 text-base sm:text-lg font-semibold max-w-3xl mx-auto leading-relaxed pt-2">
            {aboutData.heroIntro || "QShala began in 2014 with two law school friends and a love of quizzing."}
          </p>
        </div>
      </div>
    </section>

    <!-- 2. FOUNDER STORY: PROMINENT EQUAL-ASPECT CO-FOUNDER SHOWCASE -->
    <section id="founder-story" class="py-14 md:py-20 bg-[#FFF8E1] relative w-full border-t border-b border-amber-100">
      <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 space-y-10">
        
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-amber-200/60 pb-6">
          <div class="space-y-2">
            <span class="inline-block px-3.5 py-1.5 rounded-full bg-white text-slate-800 font-black text-xs uppercase tracking-wider font-heading shadow-xs border border-slate-200">
              Est. 2014
            </span>
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 font-heading tracking-tight">
              {aboutData.foundersHeading || "Meet the Co-Founders"}
            </h2>
          </div>
          <p class="text-slate-600 font-semibold text-sm sm:text-base max-w-md">
            {aboutData.foundersSubtitle || "Lawyers by training. Quizzers at heart."}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 w-full">
          {coFounders.map((founder, idx) => {
            const isFirst = idx === 0;
            const borderColor = isFirst ? 'border-amber-300' : 'border-sky-300';
            const badgeBg = isFirst ? 'bg-[#FDB913] text-slate-950' : 'bg-[#30B2E7] text-white';
            const imgPath = founder.imageUrl || getImageUrl(founder.image, isFirst ? '/assets/team/sachin-ravi.webp' : '/assets/team/raghav-chakravarthy.webp');
            const instagramLink = (founder as any).instagramUrl || (isFirst ? 'https://www.instagram.com/thesachinravi/' : 'https://www.instagram.com/raghavnc/');

            return (
              <div class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col sm:flex-row items-center sm:items-start gap-6 lg:gap-8 group">
                <div class="relative shrink-0">
                  <div class={`w-48 h-48 sm:w-56 sm:h-56 md:w-60 md:h-60 rounded-2xl md:rounded-3xl overflow-hidden aspect-square border-3 ${borderColor} shadow-md bg-amber-50 group-hover:scale-[1.02] transition-transform duration-300`}>
                    <img 
                      src={imgPath} 
                      alt={`${founder.name} - ${founder.role}`} 
                      class="w-full h-full object-cover object-center" 
                      loading="lazy"
                    />
                  </div>
                  <span class={`absolute -bottom-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full ${badgeBg} font-black text-[11px] uppercase tracking-wider font-heading shadow-sm whitespace-nowrap`}>
                    Co-Founder
                  </span>
                </div>

                <div class="space-y-3 flex-1 text-center sm:text-left pt-2 sm:pt-0">
                  <div>
                    <h3 class="text-2xl sm:text-3xl font-black text-slate-900 font-heading">{founder.name}</h3>
                    <p class="text-xs font-black uppercase tracking-wider text-amber-600 font-heading mt-0.5">
                      {founder.role || "Co-Founder"}
                    </p>
                  </div>

                  {founder.coFounderBadge && (
                    <div class="flex flex-wrap gap-1.5 justify-center sm:justify-start">
                      <span class="px-2.5 py-0.5 rounded-md bg-amber-50 text-amber-900 text-[11px] font-bold border border-amber-200">
                        {founder.coFounderBadge}
                      </span>
                    </div>
                  )}

                  <p class="text-slate-700 text-sm sm:text-base font-semibold leading-relaxed">
                    {founder.bio}
                  </p>

                  <div class="pt-3 flex items-center justify-center sm:justify-start">
                    <a 
                      href={instagramLink} 
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gradient-to-r from-[#833AB4] via-[#FD1D1D] to-[#F77737] hover:opacity-95 text-white text-xs font-black uppercase tracking-wider font-heading shadow-xs hover:shadow-md hover:-translate-y-0.5 transition-all min-h-[38px] group/btn"
                    >
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                      </svg>
                      <span>Instagram</span>
                      <span class="text-white/80 group-hover/btn:translate-x-0.5 transition-transform">&rarr;</span>
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

      </div>
    </section>

    <!-- 3. SUPPORT (INVESTORS & PARTNERS): FIXED GRID -->
    <section id="investors" class="py-14 bg-[#E8F6FD] border-t border-b border-sky-100 relative w-full">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 space-y-8">
        
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="px-3.5 py-1 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase font-heading shadow-sm">
            Supported By
          </span>
          <h2 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight font-heading">
            Backed &amp; Supported by Industry Pioneers.
          </h2>
        </div>

        <!-- Fixed 3-Column Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-2">
          {advisors.map((inv) => {
            const logoPath = inv.logoUrl || getImageUrl(inv.logo);
            return (
              <div class="p-6 rounded-3xl bg-white border border-slate-200/80 shadow-sm space-y-3 hover:shadow-md hover:-translate-y-1 transition-all flex flex-col justify-between">
                <div>
                  <div class="flex items-start justify-between gap-3">
                    <span 
                      class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase text-white font-heading shadow-sm inline-block"
                      style={`background-color: ${inv.color || '#30B2E7'};`}
                    >
                      {inv.badge}
                    </span>
                    {logoPath && (
                      <div class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center p-2 shadow-sm shrink-0">
                        <img src={logoPath} alt={inv.name} class="w-full h-full object-contain" onerror="this.style.display='none'" />
                      </div>
                    )}
                  </div>
                  <h3 class="text-lg font-black text-slate-900 font-heading leading-tight pt-3">{inv.name}</h3>
                  <p class="text-slate-600 text-xs font-semibold mt-1 leading-snug">
                    {inv.role}
                  </p>
                </div>
              </div>
            );
          })}
        </div>

      </div>
    </section>

    <!-- 4. MEET QT MASCOT SECTION -->
    <section id="meet-qt" class="py-12 md:py-16 bg-[#FFFDF5] relative w-full px-4 sm:px-8 md:px-12">
      <div class="max-w-7xl mx-auto">
        
        <div class="bg-[#FFF8E1] rounded-3xl p-5 sm:p-8 md:p-12 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-10 items-center w-full border border-amber-200/60">
          
          <!-- Left: Mascot Story -->
          <div class="lg:col-span-7 space-y-6">
            <div class="space-y-2">
              <span class="px-3.5 py-1 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase font-heading shadow-sm">
                MEET QT!
              </span>
              <h2 class="text-3xl md:text-5xl font-black text-slate-900 font-heading leading-tight">
                Meet QT, our Qurious cat.
              </h2>
            </div>

            <p class="text-slate-800 text-base md:text-lg font-semibold leading-relaxed">
              Inspired by the idea of the ever-Qurious cat, QT embodies the joy of exploring, questioning, and discovering. Unlike old superstitions, QT&apos;s all about luck, fun and sparking Quriosity wherever she goes.
            </p>

            <div class="pt-2">
              <QTAnimatedPlayer client:visible size="lg" />
            </div>
          </div>

          <!-- Right: QT Downloads -->
          <div class="lg:col-span-5 space-y-4">
            <div class="text-left space-y-1">
              <h3 class="text-2xl font-black text-slate-900 font-heading">
                QT for your everyday!
              </h3>
              <p class="text-xs font-bold text-slate-600 font-heading">Download official stickers &amp; emojis:</p>
            </div>

            <div class="flex flex-col gap-2.5 w-full sm:max-w-xs">
              <a 
                href="/assets/qt-sticker-pack.zip" 
                download
                class="px-5 py-3 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex items-center justify-between gap-4 group min-h-[44px]"
              >
                <span>QT Sticker pack</span>
                <svg class="w-3.5 h-3.5 fill-current text-slate-950 group-hover:translate-y-0.5 transition-transform" viewBox="0 0 24 24">
                  <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                </svg>
              </a>

              <a 
                href="/assets/qt-emojis.zip" 
                download
                class="px-5 py-3 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex items-center justify-between gap-4 group min-h-[44px]"
              >
                <span>QT Emojis</span>
                <svg class="w-3.5 h-3.5 fill-current text-slate-950 group-hover:translate-y-0.5 transition-transform" viewBox="0 0 24 24">
                  <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                </svg>
              </a>

              <a 
                href="/assets/qt-gifs.zip" 
                download
                class="px-5 py-3 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex items-center justify-between gap-4 group min-h-[44px]"
              >
                <span>QT Gifs</span>
                <svg class="w-3.5 h-3.5 fill-current text-slate-950 group-hover:translate-y-0.5 transition-transform" viewBox="0 0 24 24">
                  <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                </svg>
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- 5. OUR TEAM: INTERACTIVE TEAM SHOWCASE -->
    <section id="our-team" class="py-16 md:py-20 bg-[#FFFDF5] relative w-full px-4 sm:px-8 md:px-12">
      <div class="w-full">
        <InteractiveTeamShowcase members={crew} client:visible />
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
