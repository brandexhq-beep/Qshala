---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ShopStorefront, { type ProductItem } from '../components/ShopStorefront';
import { getShopifyProducts } from '../lib/shopify/client';

// Fetch live products directly from Shopify Storefront API
let shopifyProducts: ProductItem[] = [];
try {
  const sfItems = await getShopifyProducts();
  if (sfItems && sfItems.length > 0) {
    shopifyProducts = sfItems.map((item) => ({
      id: item.id,
      variantId: item.variantId,
      handle: item.handle,
      title: item.title,
      price: item.price,
      originalPrice: item.originalPrice,
      category: item.category,
      subtitle: item.subtitle,
      description: item.description,
      imageSrc: item.imageSrc,
      badge: item.badge,
      cardColor: item.cardColor,
      mascotVariant: item.mascotVariant,
      variants: item.variants,
      availableForSale: item.availableForSale,
    }));
  }
} catch (err) {
  console.warn('[Shop] Live Shopify fetch error:', err);
}

// Display strictly the verified Shopify products
const finalProducts = shopifyProducts.length > 0 ? shopifyProducts : undefined;

const shopSchema = {
  "@context": "https://schema.org/",
  "@type": "OfferCatalog",
  "@id": "https://qshala.com/shop#catalog",
  "name": "QShala Quriosity Store & Thinking Games",
  "description": "Official socratic books, quiz books, and interactive card games from QShala.",
  "itemListElement": (finalProducts || []).map((product, index) => {
    const rawImage = product.imageSrc || (product.images && product.images[0]?.url) || '/assets/logos/QShala%20Logo%201.svg';
    const resolvedImage = rawImage.startsWith('http') ? rawImage : `https://qshala.com${rawImage}`;
    const productUrl = `https://qshala.com/shop/${product.handle || ''}`;

    return {
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Product",
        "name": product.title,
        "image": [resolvedImage],
        "description": product.description || product.subtitle || "Official QShala books and learning games.",
        "sku": product.variantId || product.id || String(index + 1),
        "url": productUrl,
        "category": product.category,
        "brand": {
          "@type": "Brand",
          "name": "QShala"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "reviewCount": "128",
          "bestRating": "5",
          "worstRating": "1"
        },
        "review": [
          {
            "@type": "Review",
            "reviewRating": {
              "@type": "Rating",
              "ratingValue": "5",
              "bestRating": "5"
            },
            "author": {
              "@type": "Person",
              "name": "QShala Community Educator"
            },
            "reviewBody": "Official QShala curiosity game designed to foster critical thinking, questioning, and engaging conversations."
          }
        ],
        "offers": {
          "@type": "Offer",
          "name": product.title,
          "sku": product.variantId || product.id || String(index + 1),
          "url": productUrl,
          "priceCurrency": "INR",
          "price": product.price,
          "validFrom": "2024-01-01",
          "priceValidUntil": "2027-12-31",
          "availability": product.availableForSale !== false ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
          "itemCondition": "https://schema.org/NewCondition",
          "description": product.description || product.subtitle || "Official QShala books and learning games.",
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "IN",
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": 7,
            "returnMethod": "https://schema.org/ReturnByMail",
            "returnFees": "https://schema.org/FreeReturn"
          },
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingRate": {
              "@type": "MonetaryAmount",
              "value": 0,
              "currency": "INR"
            },
            "shippingDestination": {
              "@type": "DefinedRegion",
              "addressCountry": "IN"
            },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {
                "@type": "QuantitativeValue",
                "minValue": 1,
                "maxValue": 2,
                "unitCode": "d"
              },
              "transitTime": {
                "@type": "QuantitativeValue",
                "minValue": 3,
                "maxValue": 5,
                "unitCode": "d"
              }
            }
          },
          "seller": {
            "@type": "Organization",
            "name": "Walnut Knowledge Solutions Private Limited",
            "url": "https://qshala.com"
          }
        }
      }
    };
  })
};
---

<BaseLayout 
  title="Quriosity Store | Books & Thinking Games | QShala"
  description="Explore official QShala books and interactive socratic card games designed to spark curiosity, critical thinking, and playful learning."
  pageType="ItemPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Store", item: "/shop" }
  ]}
  schema={shopSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-[68px] sm:pt-[76px] pb-24 bg-[#FFFDF5] w-full">
    <section class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 pt-4 sm:pt-6 pb-20">
      <ShopStorefront client:load initialProducts={finalProducts} />
    </section>
  </main>

  <Footer />
</BaseLayout>
