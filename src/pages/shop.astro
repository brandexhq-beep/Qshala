---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ShopStorefront, { type ProductItem } from '../components/ShopStorefront';
import { getShopifyProducts } from '../lib/shopify/client';

// Fetch live products directly from Shopify Storefront API
let shopifyProducts: ProductItem[] = [];
try {
  const sfItems = await getShopifyProducts();
  if (sfItems && sfItems.length > 0) {
    shopifyProducts = sfItems.map((item) => ({
      id: item.id,
      variantId: item.variantId,
      handle: item.handle,
      title: item.title,
      price: item.price,
      originalPrice: item.originalPrice,
      category: item.category,
      subtitle: item.subtitle,
      description: item.description,
      imageSrc: item.imageSrc,
      badge: item.badge,
      cardColor: item.cardColor,
      mascotVariant: item.mascotVariant,
      variants: item.variants,
      availableForSale: item.availableForSale,
    }));
  }
} catch (err) {
  console.warn('[Shop] Live Shopify fetch error:', err);
}

// Display strictly the verified Shopify products
const finalProducts = shopifyProducts.length > 0 ? shopifyProducts : undefined;

const shopSchema = {
  "@type": "OfferCatalog",
  "@id": "https://qshala.vercel.app/shop#catalog",
  "name": "QShala Quriosity Store & Thinking Games",
  "description": "Official socratic books, quiz books, and interactive card games from QShala.",
  "itemListElement": (finalProducts || []).map((product, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Product",
      "name": product.title,
      "description": product.description,
      "category": product.category,
      "brand": {
        "@type": "Brand",
        "name": "QShala"
      },
      "offers": {
        "@type": "Offer",
        "priceCurrency": "INR",
        "price": product.price,
        "availability": product.availableForSale !== false ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
        "seller": {
          "@id": "https://qshala.vercel.app/#organization"
        }
      }
    }
  }))
};
---

<BaseLayout 
  title="Quriosity Store | Books & Thinking Games | QShala"
  description="Explore official QShala books and interactive socratic card games designed to spark curiosity, critical thinking, and playful learning."
  pageType="ItemPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Store", item: "/shop" }
  ]}
  schema={shopSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-[68px] sm:pt-[76px] pb-24 bg-[#FFFDF5] w-full">
    <section class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 pt-4 sm:pt-6 pb-20">
      <ShopStorefront client:load initialProducts={finalProducts} />
    </section>
  </main>

  <Footer />
</BaseLayout>
