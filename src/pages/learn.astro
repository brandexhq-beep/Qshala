---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';

const RESOURCES_CARDS = [
  {
    title: "Games",
    description: "Interactive trivia minigames, socratic memory puzzles, and daily brain teasers.",
    imageSrc: "https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Children playing educational games together",
    link: "/shop",
    badge: "Interactive",
    buttonText: "Play Minigames",
    color: "#30B2E7",
    mascotVariant: "jumping" as const
  },
  {
    title: "How to become a Quiz Master",
    description: "Step-by-step masterclass on stage presence, question crafting, and hosting live trivia.",
    imageSrc: "https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Quizmaster presenting on stage with microphone",
    link: "/blog/socratic-mindset-future-ready-kids",
    badge: "Masterclass",
    buttonText: "Read Masterclass",
    color: "#FDB913",
    mascotVariant: "idea" as const
  },
  {
    title: "Inspiration. Stories of Quriosity",
    description: "Inspiring journeys of young quizzers and quriosity champions breaking records across India.",
    imageSrc: "https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Students celebrating learning success",
    link: "/case-studies",
    badge: "Stories",
    buttonText: "Read Stories",
    color: "#75B543",
    mascotVariant: "trophy" as const
  },
  {
    title: "QUIZ NOW!",
    description: "Jump straight into daily live trivia tournaments and real-time leaderboards!",
    imageSrc: "https://images.unsplash.com/photo-1579621970563-ebec7560ff3e?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Person holding quriosity winner cards",
    link: "/book-a-quiz",
    isPlayCTA: true,
    badge: "Play Zone",
    buttonText: "QUIZ NOW!",
    color: "#EC4899",
    mascotVariant: "curious" as const
  }
];

const QUIZZING_101_CARDS = [
  {
    title: "News Sources to follow",
    description: "Hand-picked, age-appropriate current affairs portals and science magazines for young curious minds.",
    imageSrc: "https://images.unsplash.com/photo-1504711434969-e33886168f5c?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Newspaper and digital journalism sources",
    link: "/blog/daily-news-quizzing-critical-thinking",
    badge: "Curated Sources",
    buttonText: "View News Sources",
    color: "#75B543",
    mascotVariant: "reading" as const
  },
  {
    title: "Quiz Masters of History",
    description: "Lessons from legends—from Alex Trebek to Mastermind and Derek O'Brien to Sachin Ravi.",
    imageSrc: "https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Quiz masters hosting historical trivia competitions",
    link: "/about",
    badge: "Hall of Fame",
    buttonText: "Read Hall of Fame",
    color: "#30B2E7",
    mascotVariant: "holding_money" as const
  },
  {
    title: "Tips on Quriosity",
    description: "Daily observation frameworks, note-taking techniques, and quriosity habit trackers.",
    imageSrc: "https://images.unsplash.com/photo-1434030216411-0b793f4b4173?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Student writing in quriosity notebook",
    link: "/blog/curious-dinner-table",
    badge: "Habit Guide",
    buttonText: "Read Habit Guide",
    color: "#FDB913",
    mascotVariant: "idea" as const
  },
  {
    title: "QShots. Quriosity Front Gate",
    description: "Our annual Forbes-30-under-30 style mega Qualifier of news, facts, and authentic knowledge with the QShala stamp.",
    imageSrc: "https://images.unsplash.com/photo-1551836022-d5d88e9218df?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Digital news feed QShots publication",
    link: "/blog",
    isQShots: true,
    badge: "Annual Source List",
    buttonText: "Explore QShots",
    color: "#9333EA",
    mascotVariant: "trophy" as const
  }
];

const BLOG_CARDS = [
  {
    title: "Ms. Anagha on teaching children for the last 8 years.",
    description: "Reflections on socratic questioning, classroom breakthroughs, and nurturing lifelong learners.",
    imageSrc: "https://images.unsplash.com/photo-1577896851231-70ef18881754?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Teacher engaging with children in classroom",
    link: "/blog/why-rote-learning-kills-quriosity",
    author: "Ms. Anagha",
    date: "Aug 2026",
    buttonText: "Read Story",
    color: "#FDB913",
    mascotVariant: "reading" as const
  },
  {
    title: "Travels of a Quiz Master: Trip to Guwahati",
    description: "Behind the scenes hosting regional school championships across North-East India.",
    imageSrc: "https://images.unsplash.com/photo-1488646953014-85cb44e25828?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Travel and hosting quiz championship",
    link: "/blog/curious-dinner-table",
    author: "Ms. Archana",
    date: "Jul 2026",
    buttonText: "Read Story",
    color: "#30B2E7",
    mascotVariant: "jumping" as const
  },
  {
    title: "Ops or Oops! Chaos of running a live quiz",
    description: "Buzzer failures, unexpected tie-breakers, and the magic of live event operations.",
    imageSrc: "https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Live event operations technical control desk",
    link: "/blog/gamification-modern-corporate-learning",
    author: "Mr. Ahil",
    date: "Jun 2026",
    buttonText: "Read Story",
    color: "#75B543",
    mascotVariant: "idea" as const
  },
  {
    title: "Why learning needs to be fun",
    description: "The origin story of QShala and how a childhood love for trivia sparked a nation-wide quriosity movement.",
    imageSrc: "https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Co-founders founding story discussion",
    link: "/about",
    author: "Sachin & Raghavan",
    date: "May 2026",
    buttonText: "Read Story",
    color: "#EC4899",
    mascotVariant: "curious" as const
  }
];
const learnSchema = {
  "@type": "CollectionPage",
  "@id": "https://qshala.vercel.app/learn#collection",
  "name": "QShala Learn & Resources Hub",
  "description": "Curated learning tools, socratic masterclasses, and current affairs portals for young curious minds and educators.",
  "publisher": {
    "@id": "https://qshala.vercel.app/#organization"
  }
};
---

<BaseLayout 
  title="Learn & Resources Hub | Quizzing 101 & Masterclasses | QShala"
  description="Explore QShala's learning resources: Quizzing 101, socratic masterclasses, curated news sources for students, and behind-the-scenes stories."
  pageType="CollectionPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Learn", item: "/learn" }
  ]}
  schema={learnSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-header-safe pb-24 bg-[#FFFDF5] w-full">

    <!-- Top Hero Banner (Compact & Sleek with Relevant Quriosity Learning Image) -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-2">
      <div class="relative overflow-hidden rounded-3xl bg-slate-950 shadow-sm border border-slate-200/80 w-full">
        <div class="h-44 sm:h-52 relative w-full flex items-center">
          <img 
            src="https://images.unsplash.com/photo-1577896851231-70ef18881754?q=80&w=1200&auto=format&fit=crop" 
            alt="Students raising hands excitedly during interactive quiz session" 
            class="w-full h-full object-cover opacity-50"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-950/75 to-transparent flex items-center p-5 sm:p-10">
            <div class="text-white space-y-2 max-w-3xl">
              <div class="flex items-center gap-3">
                <span class="px-3.5 py-1 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase font-heading inline-block">
                  Quriosity Knowledge Hub
                </span>
                <QTMascot client:visible variant="reading" size="sm" />
              </div>
              <h1 class="text-2xl sm:text-4xl font-black font-heading tracking-tight drop-shadow-md">
                Learn &amp; Resources Hub
              </h1>
              <p class="text-slate-200 text-xs sm:text-sm font-semibold drop-shadow leading-relaxed">
                Curated learning tools, quizzing bibles, current affairs sources, and story archives for parents, students, and educators.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 1: LEARN & RESOURCES -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-4">
      <div class="p-5 sm:p-10 rounded-3xl bg-[#E8F6FD] border border-sky-100/80 shadow-sm space-y-6 w-full">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-900/10">
          <div class="space-y-1">
            <div class="flex items-center gap-3">
              <span class="px-3.5 py-1 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase font-heading">
                LEARN &amp; RESOURCES
              </span>
              <QTMascot client:visible variant="jumping" size="sm" />
            </div>
            <p class="text-slate-700 text-xs sm:text-sm font-semibold pt-1">
              Interactive minigames, masterclass guides, quriosity stories, and daily quiz launcher.
            </p>
          </div>

          <a 
            href="/shop" 
            class="px-5 py-2.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs uppercase font-heading shadow-sm hover:shadow-md transition-all shrink-0 self-start sm:self-center"
          >
            Play Daily Quiz &rarr;
          </a>
        </div>

        <!-- 4 Structured Cards Grid with Mascot on Every Card -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 w-full">
          {RESOURCES_CARDS.map((card) => (
            <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between space-y-4 w-full relative">
              
              <!-- Mascot Badge on Card -->
              <div class="absolute top-3 right-3 z-10 scale-90 origin-top-right">
                <QTMascot client:visible variant={card.mascotVariant} size="sm" />
              </div>

              <div class="space-y-3">
                <div class="relative overflow-hidden rounded-xl aspect-[4/3] bg-slate-100">
                  <img 
                    src={card.imageSrc} 
                    alt={card.imageAlt} 
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                  <span 
                    class={`absolute top-2 left-2 px-2.5 py-0.5 rounded-full font-black text-[10px] uppercase font-heading shadow-sm ${card.color === '#FDB913' ? 'text-slate-950' : 'text-white'}`}
                    style={`background-color: ${card.color};`}
                  >
                    {card.badge}
                  </span>
                </div>

                <h3 class="text-base font-black text-slate-900 font-heading leading-snug pr-8">
                  {card.title}
                </h3>

                <p class="text-slate-600 text-xs font-medium leading-relaxed">
                  {card.description}
                </p>
              </div>

              <!-- Action Button -->
              <div class="pt-3 border-t border-slate-100">
                <a 
                  href={card.link}
                  class="w-full py-3 min-h-[44px] rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs uppercase font-heading shadow-sm transition-all flex items-center justify-center gap-1.5 group"
                >
                  <span>{card.buttonText}</span>
                  <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </a>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- SECTION 2: QUIZZING 101 -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-4">
      <div class="p-5 sm:p-10 rounded-3xl bg-[#EDF7E5] border border-emerald-100/80 shadow-sm space-y-6 w-full">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-900/10">
          <div class="space-y-1">
            <div class="flex items-center gap-3">
              <span class="px-3.5 py-1 rounded-full bg-[#75B543] text-white font-black text-xs uppercase font-heading">
                Quizzing 101
              </span>
              <QTMascot client:visible variant="reading" size="sm" />
            </div>
            <p class="text-slate-700 text-xs sm:text-sm font-semibold pt-1">
              Curated resources compiled for ace Quizzers. <strong>The bible of Quizzing.</strong>
            </p>
          </div>

          <span class="px-4 py-1.5 rounded-full bg-white text-slate-900 font-black text-xs font-heading border border-slate-200 shadow-sm shrink-0 self-start sm:self-center cursor-pointer hover:bg-slate-50 transition-colors">
            See more resources &rarr;
          </span>
        </div>

        <!-- 4 Structured Cards Grid with Mascot on Every Card -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 w-full">
          {QUIZZING_101_CARDS.map((card) => (
            <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between space-y-4 w-full relative">
              
              <!-- Mascot Badge on Card -->
              <div class="absolute top-3 right-3 z-10 scale-90 origin-top-right">
                <QTMascot client:visible variant={card.mascotVariant} size="sm" />
              </div>

              <div class="space-y-3">
                <div class="relative overflow-hidden rounded-xl aspect-[4/3] bg-slate-100">
                  <img 
                    src={card.imageSrc} 
                    alt={card.imageAlt} 
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                  <span 
                    class={`absolute top-2 left-2 px-2.5 py-0.5 rounded-full font-black text-[10px] uppercase font-heading shadow-sm ${card.color === '#FDB913' ? 'text-slate-950' : 'text-white'}`}
                    style={`background-color: ${card.color};`}
                  >
                    {card.badge}
                  </span>
                </div>

                <h3 class="text-base font-black text-slate-900 font-heading leading-snug pr-8">
                  {card.title}
                </h3>

                <p class="text-slate-600 text-xs font-medium leading-relaxed">
                  {card.description}
                </p>
              </div>

              <!-- Action Button -->
              <div class="pt-3 border-t border-slate-100">
                <a 
                  href={card.link}
                  class="w-full py-3 min-h-[44px] rounded-full bg-[#30B2E7] hover:bg-sky-400 text-white font-black text-xs uppercase font-heading shadow-sm transition-all flex items-center justify-center gap-1.5 group"
                >
                  <span>{card.buttonText}</span>
                  <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </a>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- SECTION 3: BLOG -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-4">
      <div class="p-5 sm:p-10 rounded-3xl bg-[#FFF8E1] border border-amber-100/80 shadow-sm space-y-6 w-full">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-900/10">
          <div class="space-y-1">
            <div class="flex items-center gap-3">
              <span class="px-3.5 py-1 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase font-heading">
                Blog
              </span>
              <QTMascot client:visible variant="idea" size="sm" />
            </div>
            <p class="text-slate-700 text-xs sm:text-sm font-semibold pt-1">
              Chronological archive of story publications, behind-the-scene ops, and co-founder perspectives.
            </p>
          </div>

          <a 
            href="/blog" 
            class="px-5 py-2.5 rounded-full bg-slate-900 hover:bg-slate-800 text-white font-black text-xs uppercase font-heading shadow-sm hover:shadow-md transition-all shrink-0 self-start sm:self-center"
          >
            All Publications &rarr;
          </a>
        </div>

        <!-- 4 Structured Cards Grid with Mascot on Every Card -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 w-full">
          {BLOG_CARDS.map((card) => (
            <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between space-y-4 w-full relative">
              
              <!-- Mascot Badge on Card -->
              <div class="absolute top-3 right-3 z-10 scale-90 origin-top-right">
                <QTMascot client:visible variant={card.mascotVariant} size="sm" />
              </div>

              <div class="space-y-3">
                <div class="relative overflow-hidden rounded-xl aspect-[4/3] bg-slate-100">
                  <img 
                    src={card.imageSrc} 
                    alt={card.imageAlt} 
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                  <span 
                    class={`absolute top-2 left-2 px-2.5 py-0.5 rounded-full font-black text-[10px] uppercase font-heading shadow-sm ${card.color === '#FDB913' ? 'text-slate-950' : 'text-white'}`}
                    style={`background-color: ${card.color};`}
                  >
                    {card.date}
                  </span>
                </div>

                <h3 class="text-base font-black text-slate-900 font-heading leading-snug pr-8">
                  {card.title}
                </h3>

                <p class="text-slate-600 text-xs font-medium leading-relaxed">
                  {card.description}
                </p>
              </div>

              <!-- Action Button -->
              <div class="pt-3 border-t border-slate-100 space-y-2">
                <div class="text-[11px] font-bold text-slate-400 font-heading">
                  By {card.author}
                </div>
                <a 
                  href={card.link}
                  class="w-full py-3 min-h-[44px] rounded-full bg-slate-900 hover:bg-slate-800 text-white font-black text-xs uppercase font-heading shadow-sm transition-all flex items-center justify-center gap-1.5 group"
                >
                  <span>{card.buttonText}</span>
                  <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </a>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
