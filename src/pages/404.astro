---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="Page Not Found (404) | QShala"
  noindex={true}
>
  <Navbar />
  <main id="main-content" class="flex-grow pt-header-safe pb-24 px-6 flex flex-col items-center justify-center min-h-[70vh] bg-[#FFFDF5]">
    <div class="max-w-2xl mx-auto text-center space-y-8">
      <div class="relative inline-block">
        <img 
          src="/assets/qt/QT quizzing.svg" 
          alt="Confused QT Mascot" 
          width="250" 
          height="250" 
          class="mx-auto drop-shadow-xl"
        />
        <span class="absolute -top-3 right-0 sm:-right-4 px-4 py-1.5 sm:py-2 bg-[#FDB913] text-black font-black text-xs sm:text-sm rounded-full shadow-md border-2 border-black rotate-12 font-heading">
          404 Error!
        </span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-tight font-heading mt-6 sm:mt-8">
        Hmm... QT couldn&apos;t find the answer to this one!
      </h1>
      <p class="text-base sm:text-lg text-slate-600 font-medium max-w-lg mx-auto">
        It looks like the page you&apos;re searching for has moved, or maybe it&apos;s hiding like a good mystery.
      </p>
      
      <div class="pt-4 sm:pt-6">
        <a 
          href="/" 
          class="inline-block px-7 py-3.5 sm:px-8 sm:py-4 bg-[#30B2E7] hover:bg-sky-400 text-white font-black text-base sm:text-lg rounded-full shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] border-2 border-black hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] transition-all font-heading w-full sm:w-auto"
        >
          ← Back to Homepage
        </a>
      </div>
    </div>
  </main>
  <Footer />

  <!-- Smart Redirect for Dynamic Store Products -->
  <script is:inline>
    (function() {
      const path = window.location.pathname;
      if (path.startsWith('/shop/')) {
        const handle = path.replace(/^\/shop\//, '').replace(/\/+$/, '');
        if (handle) {
          window.location.replace('/shop?view=' + encodeURIComponent(handle));
        }
      }
    })();
  </script>
</BaseLayout>
