---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TypewriterHeadline from '../components/TypewriterHeadline';
import DailyQuizSection from '../components/DailyQuizSection';
import QTMascot from '../components/QTMascot';
import ClientMarquee from '../components/ClientMarquee.astro';
import TheQshalaEffect from '../components/TheQshalaEffect';
import InteractiveCaseStudiesShowcase from '../components/InteractiveCaseStudiesShowcase';
import AnimatedHeroMascotStage from '../components/AnimatedHeroMascotStage';
import FAQSection from '../components/FAQSection';
import TestimonialsMarquee from '../components/TestimonialsMarquee.astro';
import UpcomingEventsSlider from '../components/UpcomingEventsSlider';
import NewsletterSubscription from '../components/NewsletterSubscription';
import { 
  getHomePage, 
  getSiteSettings, 
  getFAQs, 
  getAllCaseStudies,
  getUpcomingEvents
} from '../lib/sanity/api';

const homeData = await getHomePage();
const siteSettings = await getSiteSettings();
const faqs = await getFAQs(true);
const caseStudies = await getAllCaseStudies();
const cmsEvents = await getUpcomingEvents();

const formattedEvents = cmsEvents.map((ev, idx) => ({
  id: ev._id || ev.id || `event-${idx}`,
  title: ev.title,
  category: ev.category,
  date: ev.date,
  desc: ev.desc || '',
  buttonType: ev.buttonType || 'none',
  buttonText: ev.buttonText || '',
  buttonUrl: ev.buttonUrl || ''
}));

const heroBadge = homeData.heroBadge || "India's Quriosity Platform";
const heroIntro = homeData.heroIntro || "QShala is India's premier quizzing company. We run quiz competitions, learning programs and team events for schools, colleges, companies and communities.";
const heroCtaLabel = homeData.heroCta?.label || "What we can do for you";
const heroCtaUrl = homeData.heroCta?.url || "/services";

const eventsHeading = homeData.eventsHeading || "Upcoming Events";
const eventsSubtitle = homeData.eventsSubtitle || "Join us for live quizzes, offline tournaments, and community events.";

const gameBadge = homeData.gameBadge || "Daily Game";
const gameHeading = homeData.gameHeading || "Test Your Quriosity";
const gameSubtitle = homeData.gameSubtitle || "Pick an answer below to trigger a celebration!";

const storeBadge = homeData.storeBadge || "Quriosity Store";
const storeHeading = homeData.storeHeading || "Books, Games & Thinking Kits.";
const storeSubtitle = homeData.storeSubtitle || "Curated conversation decks, financial literacy storybooks, and STEM lab kits designed for homes and classrooms.";

const pageTitle = homeData.seo?.metaTitle || siteSettings.defaultSeo?.metaTitle || "QShala | Quizmaster in India & Bengaluru Quizzing — Questions • Quriosity • Quests";
const pageDesc = homeData.seo?.metaDescription || siteSettings.defaultSeo?.metaDescription || "India's premier curiosity and live quiz platform. Replacing rote learning with Socratic wonder across 250+ partner schools and 80+ top corporates in Bengaluru and across India.";

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://qshala.vercel.app/#faq",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer,
    },
  })),
};
---

<BaseLayout 
  title={pageTitle}
  description={pageDesc}
  schema={faqSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow">
    
    <!-- 1. HERO (Banner) - Compact padding with safe-area clearance so blue upcoming events section peeks in first fold -->
    <section id="hero" class="relative overflow-hidden pt-hero-safe pb-4 sm:pb-6 md:pb-6 bg-[#FFFDF5]">
      
      <!-- Ambient Glowing Orbs -->
      <div class="absolute top-10 left-1/4 w-96 h-96 bg-[#30B2E7]/15 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
      <div class="absolute top-40 right-1/4 w-[28rem] h-[28rem] bg-[#FDB913]/20 rounded-full blur-3xl pointer-events-none animate-pulse" style={{ animationDelay: '1s' }}></div>

      <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 relative z-10">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- Left Content -->
          <div class="lg:col-span-7 space-y-5 text-left">
            <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white border border-slate-200 shadow-sm">
              <span class="w-2.5 h-2.5 rounded-full bg-[#30B2E7] animate-ping"></span>
              <span class="text-xs font-black uppercase text-slate-800 tracking-wider font-heading">
                {heroBadge}
              </span>
            </div>

            <div class="text-left">
              <TypewriterHeadline client:idle />
            </div>

            <p class="text-slate-600 font-semibold text-base sm:text-lg max-w-xl leading-relaxed">
              {heroIntro}
            </p>

            <div class="pt-2 flex flex-wrap items-center gap-4">
              <a
                href={heroCtaUrl}
                class="w-full sm:w-auto text-center justify-center px-6 sm:px-8 py-3.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-black font-black text-sm sm:text-base shadow-md hover:-translate-y-0.5 transition-all flex items-center gap-2 font-heading"
              >
                {heroCtaLabel}
              </a>
            </div>
          </div>

          <!-- Right Interactive Stage (Trivia Generator) -->
          <div class="lg:col-span-5 flex justify-center w-full">
            <AnimatedHeroMascotStage client:visible />
          </div>

        </div>

      </div>
    </section>

    <!-- 2. UPCOMING EVENTS (Blue section visible at bottom of fold) -->
    <section id="events" class="py-12 md:py-16 bg-[#E8F6FD] border-t border-b border-sky-100">
      <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12">
        <div class="text-center mb-10 flex flex-col items-center">
          <div class="inline-flex items-center justify-center gap-3 sm:gap-4 mb-3 flex-wrap">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 font-heading text-center">{eventsHeading}</h2>
            <div class="shrink-0">
               <QTMascot client:visible variant="happy" size="sm" className="sm:hidden" />
               <QTMascot client:visible variant="happy" size="md" className="hidden sm:inline-flex" />
            </div>
          </div>
          <p class="text-slate-600 font-semibold text-sm sm:text-base">{eventsSubtitle}</p>
        </div>
        
        <UpcomingEventsSlider client:load initialEvents={formattedEvents} />
      </div>
    </section>

    <!-- 3. TRUSTED BY THE BEST -->
    <section id="partners" class="py-16 bg-white">
      <ClientMarquee />
    </section>

    <!-- 4. THE QSHALA EFFECT (Photo gallery only) -->
    <section id="effect" class="relative overflow-hidden">
      <TheQshalaEffect client:visible />
    </section>

    <!-- 5. GAME (Daily Quiz Playground with Dynamic Rotation) -->
    <section id="game" class="py-16 md:py-24 bg-[#FFFDF5]">
      <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12">
        <div class="text-center max-w-xl mx-auto mb-12">
          <span class="px-4 py-1.5 rounded-full bg-[#75B543]/15 text-[#75B543] font-black text-xs uppercase font-heading">
            {gameBadge}
          </span>
          <h3 class="text-4xl font-black text-slate-900 mt-4 font-heading">{gameHeading}</h3>
          <p class="text-sm font-semibold text-slate-600 mt-2">{gameSubtitle}</p>
        </div>

        <DailyQuizSection client:load />
      </div>
    </section>

    <!-- 6. CURATED STORE & PRODUCTS PREVIEW -->
    <section id="store-preview" class="py-16 md:py-20 bg-white border-t border-b border-slate-100 relative">
      <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 space-y-10">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div class="space-y-2">
            <span class="inline-block px-3.5 py-1 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase font-heading shadow-xs">
              {storeBadge}
            </span>
            <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight font-heading">
              {storeHeading}
            </h2>
            <p class="text-slate-600 font-semibold text-sm sm:text-base max-w-xl">
              {storeSubtitle}
            </p>
          </div>
          
          <a 
            href="/shop" 
            class="px-6 py-3 rounded-full bg-[#30B2E7] hover:bg-sky-500 text-white font-black text-xs sm:text-sm uppercase tracking-wider font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all self-start md:self-auto shrink-0 inline-flex items-center gap-2"
          >
            <span>Explore Store</span>
            <span>&rarr;</span>
          </a>
        </div>

        <!-- 3 Curated Products Grid (1:1 Aspect Ratio) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-2">
          
          <!-- Product 1 -->
          <a href="/shop" class="bg-[#FFFDF5] rounded-3xl p-6 border border-slate-200/80 shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition-all flex flex-col justify-between space-y-4 group cursor-pointer block no-underline text-inherit">
            <div class="space-y-3">
              <div class="relative overflow-hidden rounded-2xl aspect-square bg-slate-100 shadow-xs">
                <img 
                  src="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?q=80&w=800&auto=format&fit=crop" 
                  alt="Finance Quest" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  loading="lazy"
                />
                <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-slate-900 text-white font-black text-[10px] uppercase font-heading shadow-xs">
                  Bestseller
                </span>
              </div>
              <div>
                <span class="text-[10px] font-black uppercase text-amber-600 tracking-wider font-heading">Books</span>
                <h3 class="text-xl font-black text-slate-900 group-hover:text-[#30B2E7] transition-colors font-heading leading-snug">Finance Quest</h3>
                <p class="text-slate-600 text-xs font-semibold mt-1 line-clamp-2">
                  Interactive storybook teaching kids saving, budgeting, and smart money mindsets.
                </p>
              </div>
            </div>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xl font-black text-slate-900 font-heading">₹299/-</span>
              <span class="px-5 py-2.5 min-h-[44px] rounded-full bg-[#FDB913] group-hover:bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-xs group-hover:shadow-sm transition-all inline-flex items-center justify-center">
                View &rarr;
              </span>
            </div>
          </a>

          <!-- Product 2 -->
          <a href="/shop" class="bg-[#FFFDF5] rounded-3xl p-6 border border-slate-200/80 shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition-all flex flex-col justify-between space-y-4 group cursor-pointer block no-underline text-inherit">
            <div class="space-y-3">
              <div class="relative overflow-hidden rounded-2xl aspect-square bg-slate-100 shadow-xs">
                <img 
                  src="https://images.unsplash.com/photo-1610890716171-6b1bb98ffd09?q=80&w=800&auto=format&fit=crop" 
                  alt="Socratic Dinner Deck" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  loading="lazy"
                />
                <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-[#30B2E7] text-white font-black text-[10px] uppercase font-heading shadow-xs">
                  Family Favorite
                </span>
              </div>
              <div>
                <span class="text-[10px] font-black uppercase text-sky-600 tracking-wider font-heading">Games</span>
                <h3 class="text-xl font-black text-slate-900 group-hover:text-[#30B2E7] transition-colors font-heading leading-snug">Socratic Dinner Deck</h3>
                <p class="text-slate-600 text-xs font-semibold mt-1 line-clamp-2">
                  100 thought-provoking conversation prompt cards that turn dinner into discovery.
                </p>
              </div>
            </div>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xl font-black text-slate-900 font-heading">₹499/-</span>
              <span class="px-5 py-2.5 min-h-[44px] rounded-full bg-[#FDB913] group-hover:bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-xs group-hover:shadow-sm transition-all inline-flex items-center justify-center">
                View &rarr;
              </span>
            </div>
          </a>

          <!-- Product 3 -->
          <a href="/shop" class="bg-[#FFFDF5] rounded-3xl p-6 border border-slate-200/80 shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition-all flex flex-col justify-between space-y-4 group cursor-pointer block no-underline text-inherit">
            <div class="space-y-3">
              <div class="relative overflow-hidden rounded-2xl aspect-square bg-slate-100 shadow-xs">
                <img 
                  src="https://images.unsplash.com/photo-1532094349884-543bc11b234d?q=80&w=800&auto=format&fit=crop" 
                  alt="Science Quest Lab Kit" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  loading="lazy"
                />
                <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-[#75B543] text-white font-black text-[10px] uppercase font-heading shadow-xs">
                  STEM Kit
                </span>
              </div>
              <div>
                <span class="text-[10px] font-black uppercase text-emerald-600 tracking-wider font-heading">Learning Kits</span>
                <h3 class="text-xl font-black text-slate-900 group-hover:text-[#30B2E7] transition-colors font-heading leading-snug">Science Quest Lab Kit</h3>
                <p class="text-slate-600 text-xs font-semibold mt-1 line-clamp-2">
                  Safe, reusable physics &amp; chemistry lab kit with 25 hands-on experiments.
                </p>
              </div>
            </div>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xl font-black text-slate-900 font-heading">₹799/-</span>
              <span class="px-5 py-2.5 min-h-[44px] rounded-full bg-[#FDB913] group-hover:bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-xs group-hover:shadow-sm transition-all inline-flex items-center justify-center">
                View &rarr;
              </span>
            </div>
          </a>

        </div>

      </div>
    </section>

    <!-- 7. NEWSLETTER / QSHOTS -->
    <section id="newsletter" class="pt-16 pb-12 md:pt-20 md:pb-16 bg-[#F2FCE8] relative overflow-hidden border-t border-[#75B543]/20">
      <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 flex flex-col lg:flex-row items-center justify-between gap-12 relative z-10">
        
        <!-- Left Content -->
        <div class="text-center lg:text-left space-y-3 max-w-xl">
          <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight font-heading">
            Subscribe to QQL Club
          </h2>
          <p class="text-slate-700 text-base md:text-lg font-semibold leading-relaxed">
            Five questions in your inbox every day, and a Monthly Mega Quiz every month. ₹499 for six months.
          </p>
        </div>
        
        <!-- Right Form & Mascot -->
        <div class="w-full lg:w-1/2 flex flex-col sm:flex-row items-center justify-center lg:justify-end gap-6">
          <div class="w-full max-w-md">
            <NewsletterSubscription client:visible variant="qql" isDirectLink={true} buttonLabel="Subscribe" />
          </div>

          <!-- Mascot -->
          <div class="hidden sm:block shrink-0 transform hover:scale-110 hover:-rotate-6 transition-transform duration-300">
             <QTMascot client:visible variant="happy" size="md" />
          </div>
        </div>

      </div>

      <!-- Downward Continuation Flow Cue -->
      <div class="mt-8 flex justify-center items-center gap-2 text-slate-500 text-xs font-black uppercase tracking-wider font-heading">
        <span>Scroll to explore real stories &amp; impact</span>
        <svg class="w-4 h-4 animate-bounce text-[#75B543]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </section>

    <!-- 7. CASE STUDIES (Simplified: Photo, school name & single text box) -->
    <section id="case-studies" class="py-16 md:py-24 bg-white">
      <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 space-y-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between">
          <div>
            <span class="px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm">
              Real Impact Stories
            </span>
            <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight mt-4 font-heading">
              Quriosity in Action.
            </h2>
          </div>
          <a href="/case-studies" class="mt-4 md:mt-0 px-6 py-3 rounded-full bg-[#30B2E7] hover:bg-sky-500 text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all inline-block">
            See Our Work &rarr;
          </a>
        </div>

        <InteractiveCaseStudiesShowcase caseStudies={caseStudies as any} client:visible />
      </div>
    </section>

    <!-- 8. WALL OF LOVE -->
    <div class="bg-[#FFFDF5] pt-12 pb-24">
      <TestimonialsMarquee />
    </div>

    <!-- 9. FREQUENTLY ASKED QUESTIONS -->
    <section id="faq" class="pt-12 pb-8 md:pt-16 md:pb-12 bg-[#FFFDF5] relative">
      <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12">
        <div class="text-center max-w-2xl mx-auto mb-10 space-y-3">
          <span class="px-4 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase tracking-wider font-heading">
            How can we help?
          </span>
          <h2 class="text-4xl md:text-5xl font-black text-slate-900 font-heading">Frequently Asked Questions</h2>
        </div>
        <FAQSection items={faqs} client:load />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
