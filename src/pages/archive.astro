---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ArchiveEventsList from '../components/ArchiveEventsList';
const archiveSchema = {
  "@type": "CollectionPage",
  "@id": "https://qshala.com/archive#collection",
  "name": "Past Events & Quiz Archive | QShala India",
  "description": "Historical archive of past quizzes, inter-school tournaments, college championships, and corporate trivia leagues conducted by QShala across India.",
  "publisher": {
    "@id": "https://qshala.com/#organization"
  }
};
---

<BaseLayout 
  title="Past Events & Quiz Archive | QShala India"
  description="Browse the archive of past quizzes, tournaments, festivals, and live competitions conducted by QShala across schools, colleges, and corporate partners."
  pageType="CollectionPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Archive", item: "/archive" }
  ]}
  schema={archiveSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-header-safe pb-24 bg-[#FFFDF5] w-full">

    {/* Notice banner: Event reports moved to Blog */}
    <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-4 pb-2">
      <div class="bg-[#FFF8E1] rounded-2xl p-4 sm:p-5 border border-amber-200/80 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 text-center sm:text-left">
          <span class="text-xl">📸</span>
          <p class="text-slate-800 text-xs sm:text-sm font-semibold">
            Looking for recent event photo galleries and championship reports? Check out our active <strong class="text-slate-950 font-black">Event Coverage on the Blog</strong>.
          </p>
        </div>
        <a 
          href="/blog"
          class="w-full sm:w-auto text-center justify-center min-h-[44px] px-5 py-2.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider font-heading shrink-0 shadow-sm transition-all inline-flex items-center active:scale-95"
        >
          <span>View Event Reports</span>
          <span class="ml-1.5">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Archive Filter & Events List Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 py-6">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-8">
        <span class="inline-block px-3.5 py-1 rounded-full bg-slate-200 text-slate-800 text-xs font-black uppercase font-heading">
          Historical Directory
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 font-heading">
          Past Events Directory
        </h1>
        <p class="text-slate-600 text-sm sm:text-base font-semibold">
          Search historical tournaments and inter-school championships conducted by QShala.
        </p>
      </div>

      <ArchiveEventsList client:load />
    </section>

  </main>

  <Footer />
</BaseLayout>
