---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';
import FAQSection from '../components/FAQSection';
import ContactForm from '../components/ContactForm';
import { getSiteSettings, getFAQs } from '../lib/sanity/api';

const [siteSettings, faqs] = await Promise.all([
  getSiteSettings(),
  getFAQs()
]);

const CAREERS_ROLES = [
  {
    slug: "careers-marketing-manager",
    title: "Marketing Manager",
    description: "Lead brand campaigns, school outreach, and digital quriosity stories.",
    imageSrc: "/assets/media/corporate/photo-2026-10-09-16-30-24.webp",
    color: "#EDF7E5"
  },
  {
    slug: "careers-operations-associate",
    title: "Operations Associate",
    description: "Manage live quiz event logistics, buzzer setups, and school coordination.",
    imageSrc: "/assets/media/banners/teams-3_1.webp",
    color: "#FFF8E1"
  },
  {
    slug: "careers-engagement-associate",
    title: "Engagement Associate",
    description: "Facilitate socratic sessions, host interactive trivia, and inspire young quizzers.",
    imageSrc: "/assets/media/schools/untitled_design.webp",
    color: "#E8F6FD"
  },
  {
    slug: "careers-video-editor",
    title: "Video Editor",
    description: "Craft exciting video highlight reels, QShots clips, and animated stories.",
    imageSrc: "/assets/media/crowd/dsc07629.webp",
    color: "#EDF7E5"
  }
];

const localBusinessSchema = {
  "@type": "LocalBusiness",
  "@id": "https://qshala.vercel.app/contact#localbusiness",
  "name": "QShala Headquarters",
  "image": "https://qshala.vercel.app/og-image.jpg",
  "telephone": siteSettings.contactPhone || "+91-89716-76100",
  "email": siteSettings.contactEmail || "qshala@walnuts.co.in",
  "priceRange": "$$",
  "currenciesAccepted": "INR",
  "paymentAccepted": "Credit Card, Debit Card, UPI, Net Banking",
  "openingHours": "Mo-Sa 09:00-18:00",
  "hasMap": siteSettings.googleMapsUrl || "https://maps.google.com/?q=Walnut+Knowledge+Solutions+JP+Nagar+Bengaluru",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteSettings.address || "1st Floor, 680, Fortuna 1, 8th Main Road, 14th Cross Road, Near Delmia Circle, 3rd Phase, J.P. Nagar",
    "addressLocality": "Bengaluru",
    "addressRegion": "Karnataka",
    "postalCode": "560078",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 12.9063,
    "longitude": 77.5857
  },
  "url": "https://qshala.vercel.app/contact",
  "parentOrganization": {
    "@id": "https://qshala.vercel.app/#organization"
  }
};
---

<BaseLayout 
  title="Contact QShala | Office Location, Phone & Careers"
  description="Get in touch with QShala. Visit our Bengaluru headquarters in JP Nagar, call +91-89716-76100, or explore career opportunities in education and quizzing."
  pageType="ContactPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Contact", item: "/contact" }
  ]}
  schema={localBusinessSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-header-safe pb-24 bg-[#FFFDF5] w-full">

    <!-- Top Header -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-6 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase font-heading shadow-sm">
        <span>Get in Touch</span>
        <QTMascot client:visible variant="happy" size="sm" />
      </div>

      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 font-heading tracking-tight">
        {siteSettings.contactHeading || "We'd Love to Hear From You."}
      </h1>
      
      <p class="text-slate-600 font-semibold text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        {siteSettings.contactSubheading || "Tell us about your school, company, college or community, or ask us anything about our quizzes. We'll write back and plan something together."}
      </p>
    </section>

    <!-- SECTION 1: Address & Reach Out Banners + Team Photo Section -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-6">
      <div class="max-w-[1536px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Left Column: Physical Address + Quick Contact Cards -->
        <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
          <!-- Write to us the old school way (Physical Address) -->
          <div class="p-6 sm:p-8 rounded-3xl bg-white border border-slate-200/80 shadow-sm space-y-4">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-2xl bg-[#30B2E7] text-white flex items-center justify-center font-bold text-lg shadow-sm shrink-0">
                🏢
              </span>
              <h2 class="text-xl sm:text-2xl font-black text-slate-900 font-heading">
                Write to us the old school way
              </h2>
            </div>

            <p class="text-slate-700 text-sm sm:text-base font-semibold leading-relaxed">
              {siteSettings.address || "1st Floor, 680, Fortuna 1, 8th Main Road, 14th Cross Road, Near Delmia Circle, 3rd Phase, J.P. Nagar, Bengaluru, Karnataka - 560078"}
            </p>

            <div class="pt-2">
              <a
                href={siteSettings.googleMapsUrl || "https://maps.google.com/?q=Walnut+Knowledge+Solutions+JP+Nagar+Bengaluru"}
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-2.5 rounded-full bg-[#30B2E7] hover:bg-sky-400 text-white font-black text-xs uppercase font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all inline-flex items-center gap-2"
              >
                <span>VIEW ON MAP</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>

          <!-- Reach out! Action Banner Buttons -->
          <div class="space-y-3">
            <h2 class="text-xl font-black text-slate-900 font-heading">
              Reach out directly!
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- CALL US AT -->
              <a
                href={`tel:${(siteSettings.contactPhone || "+918971676100").replace(/[^0-9+]/g, '')}`}
                class="p-5 rounded-3xl bg-[#FFF8E1] hover:bg-amber-100 border border-amber-200/80 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex items-center gap-3 group"
              >
                <span class="w-10 h-10 rounded-2xl bg-[#FDB913] text-slate-950 flex items-center justify-center text-lg font-bold shadow-sm shrink-0">
                  📞
                </span>
                <div class="min-w-0">
                  <div class="text-[11px] font-black uppercase text-amber-800 tracking-wider font-heading">Call Us</div>
                  <div class="text-slate-900 font-heading font-black text-xs sm:text-sm group-hover:text-amber-900 transition-colors truncate">
                    {siteSettings.contactPhone || "+91 89716 76100"}
                  </div>
                </div>
              </a>

              <!-- WRITE TO US AT -->
              <a
                href={`mailto:${siteSettings.contactEmail || "qshala@walnuts.co.in"}`}
                class="p-5 rounded-3xl bg-[#E8F6FD] hover:bg-sky-100 border border-sky-200/80 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex items-center gap-3 group"
              >
                <span class="w-10 h-10 rounded-2xl bg-[#30B2E7] text-white flex items-center justify-center text-lg font-bold shadow-sm shrink-0">
                  ✉
                </span>
                <div class="min-w-0">
                  <div class="text-[11px] font-black uppercase text-sky-800 tracking-wider font-heading">Email Us</div>
                  <div class="text-slate-900 font-heading font-black text-xs sm:text-sm group-hover:text-sky-900 transition-colors truncate">
                    {siteSettings.contactEmail || "qshala@walnuts.co.in"}
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: Team / Workspace Photo Section (Bridges to Careers) -->
        <div class="lg:col-span-5 flex">
          <div class="w-full rounded-3xl bg-white border border-slate-200/80 shadow-sm overflow-hidden flex flex-col justify-between group hover:shadow-md transition-shadow">
            <div class="relative overflow-hidden aspect-[16/10] sm:aspect-[16/9] lg:aspect-auto lg:h-56 bg-slate-100">
              <img
                src="/assets/media/banners/team_photo.webp"
                alt="QShala Curiosity Crew - Collaborative team and quiz designers"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute top-3 right-3 px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-white font-heading font-black text-[10px] uppercase tracking-wider flex items-center gap-1.5 shadow-xs">
                <span class="w-2 h-2 rounded-full bg-[#75B543] animate-pulse"></span>
                <span>Team & Culture</span>
              </div>
            </div>

            <div class="p-6 sm:p-7 space-y-3 flex-grow flex flex-col justify-between bg-gradient-to-b from-white to-[#FFFDF5]">
              <div class="space-y-2">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#EDF7E5] text-[#2E7D32] font-black text-[11px] uppercase font-heading">
                  <span>Our Quriosity Crew</span>
                </div>
                <h3 class="text-xl font-black text-slate-900 font-heading leading-snug">
                  Minds Behind India&apos;s Favourite Questions
                </h3>
                <p class="text-slate-600 text-xs sm:text-sm font-semibold leading-relaxed">
                  A team of quizmasters, educators, writers and researchers who love a good question and sharing the joy of learning across India.
                </p>
              </div>

              <div class="pt-3 border-t border-slate-100">
                <a
                  href="#careers"
                  class="inline-flex items-center gap-2 text-xs font-black text-[#75B543] hover:text-[#5d9435] uppercase tracking-wider font-heading transition-colors"
                >
                  <span>Looking to join the crew? Explore open roles</span>
                  <span>&darr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION 2: CAREERS -->
    <section id="careers" class="w-full px-4 sm:px-8 md:px-12 py-10 bg-[#EDF7E5] border-y border-emerald-100 my-8 scroll-mt-24">
      <div class="max-w-6xl mx-auto space-y-8">
        
        <div class="text-center space-y-2">
          <span class="px-4 py-1 rounded-full bg-[#75B543] text-white font-black text-xs uppercase font-heading shadow-sm">
            CAREERS
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading tracking-tight">
            Want to be a Quriosity catalyst? Work with us!
          </h2>
          <p class="text-slate-700 text-xs sm:text-sm font-semibold">
            Send your portfolio or resume to <a href="mailto:work@walnuts.co.in" class="text-slate-900 font-black underline hover:text-[#75B543]">work@walnuts.co.in</a>
          </p>
        </div>

        <!-- 4 Role Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {CAREERS_ROLES.map((role) => (
            <a
              href={`/blog/${role.slug}`}
              class="rounded-3xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between space-y-4 group bg-white cursor-pointer"
              aria-label={`View full job description for ${role.title}`}
            >
              <div class="space-y-3">
                <div class="relative overflow-hidden rounded-2xl aspect-[4/3] bg-slate-100">
                  <img
                    src={role.imageSrc}
                    alt={role.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>

                <h3 class="text-lg font-black text-slate-900 font-heading leading-snug group-hover:text-[#75B543] transition-colors">
                  {role.title}
                </h3>

                <p class="text-slate-700 text-xs font-semibold leading-relaxed">
                  {role.description}
                </p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between font-heading font-black text-xs text-slate-900 group-hover:text-[#75B543] transition-colors">
                <span>View Full JD &amp; Details</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>

    <!-- SECTION 3: FREQUENTLY ASKED QUESTIONS -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-10">
      <div class="max-w-4xl mx-auto space-y-8">
        <div class="text-center space-y-3 pb-8">
          <span class="inline-block px-4 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm border border-[#75B543]">
            Need Clarification?
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading tracking-tight">
            Frequently Asked Questions
          </h2>
          <p class="text-slate-600 text-sm sm:text-base font-semibold max-w-xl mx-auto leading-relaxed">
            Got questions about QShala programs, corporate trivia, or joining the team? Here is what most folks ask.
          </p>
        </div>
        <FAQSection client:load items={faqs.slice(0, 6)} />
      </div>
    </section>

    <!-- SECTION 4: Quick Inquiry Message Form -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-10">
      <div class="max-w-2xl mx-auto bg-white rounded-3xl p-5 sm:p-8 border border-slate-200/80 shadow-sm space-y-6">
        <div class="text-center space-y-1">
          <h3 class="text-2xl font-black text-slate-900 font-heading">Send Us a Direct Message</h3>
          <p class="text-slate-600 text-xs font-semibold">We respond to all inquiries within 24 hours.</p>
        </div>

        <ContactForm client:load />
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
