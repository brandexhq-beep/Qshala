---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MultiStepBooking from '../components/MultiStepBooking';

const bookingServiceSchema = {
  "@type": "Service",
  "@id": "https://qshala.com/book-a-quiz#service",
  "name": "Custom Quiz Curation & Quizmaster Services",
  "serviceType": "Live & Virtual Event Quizzing",
  "description": "Tailored quizmaster hosting, custom question curation, multimedia buzzer systems, and live leaderboards for schools, corporates, colleges, and private events.",
  "provider": {
    "@id": "https://qshala.com/#organization"
  }
};
---

<BaseLayout 
  title="Let's Talk Quizzes | Get in Touch with QShala"
  description="Leave your name and a way to reach you, and someone from our team will get back to you within a day."
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Get in Touch", item: "/book-a-quiz" }
  ]}
  schema={bookingServiceSchema}
>
  <Navbar />
  <main id="main-content" class="flex-grow pt-header-safe pb-16 sm:pb-24 px-4 sm:px-6">
    <div class="w-full max-w-[1536px] mx-auto px-2 sm:px-4 md:px-8 space-y-8 sm:space-y-10">
      <div class="text-center max-w-2xl mx-auto">
        <span class="px-4 py-1.5 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase tracking-wider border border-black font-heading inline-block shadow-xs">
          Get in Touch
        </span>
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-tight mt-3 font-heading">
          Let&apos;s Talk <span class="text-[#30B2E7]">Quizzes.</span>
        </h1>
        <p class="text-slate-700 text-base sm:text-lg mt-3 font-semibold leading-relaxed">
          Leave your name and a way to reach you, and someone from our team will get back to you within a day. If you&apos;re still figuring out what you need, that&apos;s a perfectly good place to start.
        </p>
      </div>

      <!-- React Island Hydrated client:idle for optimal LCP -->
      <MultiStepBooking client:idle />
    </div>
  </main>
  <Footer />
</BaseLayout>
