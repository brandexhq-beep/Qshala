---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';
import { getServicePage } from '../lib/sanity/api';

const pageData = await getServicePage('communities');

const COMMUNITY_OFFERINGS = pageData.offerings || [
  {
    title: "Apartments & Neighbourhoods",
    desc: "A quiz night for your housing society, with teams and questions for every age.",
    accent: "#30B2E7",
    bg: "bg-[#E8F6FD]"
  },
  {
    title: "Families",
    desc: "Want kids and grandparents on the same team? A family quiz with questions that work across generations.",
    accent: "#75B543",
    bg: "bg-[#EDF7E5]"
  },
  {
    title: "Birthdays & Weddings",
    desc: "A quiz for your guests, built around the person or the couple being celebrated.",
    accent: "#FDB913",
    bg: "bg-[#FFF8E1]"
  },
  {
    title: "Pub Quizzes",
    desc: "Run a pub, café or club? A quiz night, one-off or regular, for your regulars and newcomers alike.",
    accent: "#9333EA",
    bg: "bg-[#F3E8FF]"
  },
  {
    title: "QQL Club",
    desc: "Make quizzing a daily habit at home. Five fresh questions arrive by email every day, with an answer review after each quiz and a Monthly Mega Quiz at the end of every month. ₹499 for six months from the day you join, whether you're eight or eighty.",
    accent: "#EC4899",
    bg: "bg-[#FCE7F3]",
    badge: "₹499 / 6 months"
  }
];

const badge = pageData.badge || "Communities & Families";
const headline = pageData.headline || "Host a Quiz at Your Next Gathering!";
const intro = pageData.intro || "At home, in your apartment building, at a party. If there's a crowd and a reason to celebrate, we'll bring the questions. All ages welcome.";
const mascotVariant = (pageData.mascotVariant || "curious") as any;

const communityServiceSchema = {
  "@type": "Service",
  "@id": "https://qshala.vercel.app/communities#service",
  "name": headline,
  "serviceType": "Community Quizzing, Society Tournaments & Family Game Nights",
  "description": intro,
  "provider": {
    "@id": "https://qshala.vercel.app/#organization"
  }
};
---

<BaseLayout 
  title={`${badge} | ${headline} | QShala`}
  description={intro}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Services", item: "/services" },
    { name: badge, item: "/communities" }
  ]}
  schema={communityServiceSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-header-safe pb-24 w-full bg-[#FFFDF5]">
    <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 space-y-16 sm:space-y-20">
      
      <!-- Hero Section -->
      <div class="text-center max-w-4xl mx-auto space-y-4 pt-4">
        <span class="inline-block px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm">
          {badge}
        </span>
        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight">
          {headline}
        </h1>
        <p class="text-slate-700 font-semibold text-base sm:text-xl leading-relaxed max-w-3xl mx-auto">
          {intro}
        </p>

        <!-- Mascot Bubble -->
        <div class="pt-4 flex justify-center">
          <QTMascot client:visible variant={mascotVariant} size="lg" badgeText="All Ages Welcome!" />
        </div>
      </div>

      <!-- Offerings Grid -->
      <section class="space-y-8">
        <div class="border-b border-slate-200 pb-4">
          <span class="text-xs font-black uppercase tracking-wider text-[#30B2E7] font-heading">Gatherings &amp; Events</span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading">
            Bring Wonder to Any Room
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {COMMUNITY_OFFERINGS.map((item) => (
            <div class={`rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm hover:shadow-md transition-all ${item.bg} flex flex-col justify-between space-y-4`}>
              <div class="space-y-3">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <span 
                    class={`px-3 py-1 rounded-full text-[11px] font-black uppercase font-heading shadow-xs ${item.accent === '#FDB913' ? 'text-slate-950' : 'text-white'}`}
                    style={`background-color: ${item.accent};`}
                  >
                    Community
                  </span>
                  {item.badge && (
                    <span class="px-3 py-1 rounded-full bg-slate-900 text-white text-[11px] font-black uppercase font-heading shadow-xs">
                      {item.badge}
                    </span>
                  )}
                </div>

                <h3 class="text-2xl font-black text-slate-900 font-heading leading-snug">
                  {item.title}
                </h3>

                <p class="text-slate-700 text-sm sm:text-base font-semibold leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- EXACT CONTACT BLOCK FROM COPY -->
      <div class="bg-[#E8F6FD] rounded-3xl p-6 sm:p-10 md:p-12 border-2 border-sky-200 shadow-md text-center max-w-4xl mx-auto space-y-8">
        <div class="space-y-2">
          <span class="px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase font-heading shadow-xs">
            Let's work together!
          </span>
          <h2 class="text-3xl sm:text-5xl font-black text-slate-900 font-heading">
            Let's work together!
          </h2>
          <p class="text-slate-700 font-semibold text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
            Hosting something for your society, club or family? Tell us who's coming and what the occasion is.
          </p>
        </div>

        <!-- Direct Contact Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto text-left">
          
          <!-- Department Head -->
          <div class="p-6 rounded-2xl bg-white border border-sky-200 shadow-sm space-y-3 flex flex-col justify-between">
            <div>
              <div class="text-xs font-black uppercase text-sky-600 font-heading">Department Head</div>
              <div class="text-lg font-black text-slate-900 font-heading leading-tight mt-1">Community Team</div>
            </div>
            <div class="pt-2 space-y-2 border-t border-slate-100">
              <a 
                href="mailto:qshala@walnuts.co.in" 
                class="inline-flex items-center gap-2 text-xs font-black text-slate-800 hover:text-sky-700 font-heading break-all"
              >
                ✉ qshala@walnuts.co.in
              </a>
              <div>
                <a 
                  href="tel:+919947825806" 
                  class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full bg-[#30B2E7] text-white font-black text-xs font-heading shadow-xs hover:bg-sky-500 transition-colors w-full text-center min-h-[44px]"
                >
                  📞 Call: +91 99478 25806
                </a>
              </div>
            </div>
          </div>

          <!-- Co-Founder Sachin Ravi -->
          <div class="p-6 rounded-2xl bg-white border border-sky-200 shadow-sm space-y-3 flex flex-col justify-between">
            <div class="flex items-center gap-3.5">
              <img 
                src="/assets/team/sachin-ravi.webp" 
                alt="Sachin Ravi" 
                class="w-14 h-14 rounded-xl object-cover object-center border-2 border-sky-300 shadow-xs shrink-0 aspect-square" 
              />
              <div>
                <div class="text-xs font-black uppercase text-sky-600 font-heading">Co-Founder</div>
                <div class="text-lg font-black text-slate-900 font-heading leading-tight">Sachin Ravi</div>
              </div>
            </div>
            <div class="pt-2 space-y-2 border-t border-slate-100">
              <a 
                href="mailto:sachin@walnuts.co.in" 
                class="inline-flex items-center gap-2 text-xs font-black text-slate-800 hover:text-sky-700 font-heading break-all"
              >
                ✉ sachin@walnuts.co.in
              </a>
              <div>
                <a 
                  href="tel:+919008043525" 
                  class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs font-heading shadow-xs hover:bg-amber-400 transition-colors w-full text-center min-h-[44px]"
                >
                  📞 Call Sachin: +91 90080 43525
                </a>
              </div>
            </div>
          </div>

        </div>

        <!-- Quick WhatsApp Action -->
        <div class="pt-2">
          <a 
            href="https://wa.me/919008043525?text=Hi%20QShala,%20we%20would%20like%20to%20host%20a%20family%20or%20community%20quiz." 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all w-full sm:w-auto text-center min-h-[44px]"
          >
            <span>Chat on WhatsApp &rarr;</span>
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>
